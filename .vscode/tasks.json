{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TScanner: Install pinned dependencies",
      "type": "process",
      "command": "npx",
      "windows": {
        "command": "npx.cmd"
      },
      "args": [
        "--yes",
        "--package",
        "yarn@1.22.22",
        "yarn",
        "--cwd",
        ".tscanner",
        "install",
        "--frozen-lockfile",
        "--ignore-scripts",
        "--production=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TScanner: Set up local editor",
      "detail": "Install pinned tooling and set the native TScanner path while preserving local VSCode settings.",
      "dependsOn": "TScanner: Install pinned dependencies",
      "type": "process",
      "command": "node",
      "args": [".tscanner/scripts/editor.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TScanner: Scan full project",
      "type": "process",
      "command": "node",
      "args": ["scripts/ci/tscanner.mjs", "--report-dir", ".tscanner/reports"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TScanner: Scan staged changes",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/ci/tscanner.mjs",
        "--staged",
        "--report-dir",
        ".tscanner/reports"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TScanner: Scan uncommitted changes",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/ci/tscanner.mjs",
        "--uncommitted",
        "--report-dir",
        ".tscanner/reports"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
