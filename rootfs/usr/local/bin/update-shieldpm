#!/bin/bash
set -euo pipefail

# Only run as root
if [ "$EUID" -ne 0 ]; then
  echo "Please run as root"
  exit 1
fi

# Keep one maintenance operation active, including both updater exec handoffs.
# Never unlink this file: another process could otherwise lock a different inode.
MAINTENANCE_LOCK_DIR=/run/shieldpm-maintenance
if ! command -v flock >/dev/null 2>&1; then
    echo "ShieldPM maintenance requires flock from util-linux." >&2
    exit 1
fi
if [ -L "$MAINTENANCE_LOCK_DIR" ]; then
    echo "Unsafe ShieldPM maintenance lock directory." >&2
    exit 1
fi
install -d -o 0 -g 0 -m 700 "$MAINTENANCE_LOCK_DIR"
MAINTENANCE_LOCK="$MAINTENANCE_LOCK_DIR/operation.lock"
if ! [[ /proc/$$/fd/9 -ef "$MAINTENANCE_LOCK" ]]; then
    exec 9>"$MAINTENANCE_LOCK"
fi
if ! flock -n 9; then
    echo "Another ShieldPM install or update is already running." >&2
    exit 1
fi

# Use a private, unpredictable directory before replacing the installed updater.
SELF_PATH=$(readlink -f "$0")
if [[ "$SELF_PATH" != /tmp/shieldpm-update.*/update-shieldpm || "$SELF_PATH" != "${SHIELDPM_UPDATE_RUNNING:-}" ]]; then
    UPDATE_RUN_DIR=$(mktemp -d /tmp/shieldpm-update.XXXXXX)
    install -m 700 "$SELF_PATH" "$UPDATE_RUN_DIR/update-shieldpm"
    export SHIELDPM_UPDATE_RUNNING="$UPDATE_RUN_DIR/update-shieldpm"
    exec /bin/bash "$SHIELDPM_UPDATE_RUNNING" "$@"
fi
UPDATE_RUN_DIR=$(dirname "$SELF_PATH")
UPDATE_ROLLBACK=false
cleanup_update() {
    local result=$?
    if [ "$UPDATE_ROLLBACK" = true ]; then
        echo "Update interrupted before migrations; restoring application files..."
        if find "$BACKEND_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && \
            find "$FRONTEND_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && \
            cp -a "$UPDATE_RUN_DIR/backend-backup/." "$BACKEND_DIR/" && \
            cp -a "$UPDATE_RUN_DIR/frontend-backup/." "$FRONTEND_DIR/"; then
            systemctl daemon-reload || true
            systemctl start shieldpm || true
        else
            echo "Application recovery failed. Backups retained in $UPDATE_RUN_DIR."
            return "$result"
        fi
    elif [ "$result" -ne 0 ] && [ -d "$UPDATE_RUN_DIR/backend-backup" ]; then
        echo "Update failed after backups were created. Recovery files retained in $UPDATE_RUN_DIR."
        echo "Check the database migration state before manually restoring older application files."
        return "$result"
    fi
    rm -rf "$UPDATE_RUN_DIR"
    return "$result"
}
trap cleanup_update EXIT

REPO_URL="https://github.com/shedowe19/ShieldPM.git"

BRANCH="develop" # Default branch for content

# Preserve original arguments for self-update restart
ORIGINAL_ARGS=("$@")

# Argument Parsing
while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--branch)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        echo "A branch name is required after $1."
        exit 1
      fi
      BRANCH="$2"
      shift # past argument
      shift # past value
      ;;
    *)
      shift # past argument
      ;;
  esac
done

TEMP_DIR="$UPDATE_RUN_DIR/source"
BACKEND_DIR="/app"
FRONTEND_DIR="/html/frontend"

echo "=========================================="
echo "🛡️ ShieldPM In-Place Update Utility"
echo "=========================================="
echo "Target Branch: $BRANCH"
echo "Temp Dir:      $TEMP_DIR"
echo "Binary Tag:    nginx-binaries (Rolling)"
echo "=========================================="

echo ""
echo "⚠️  WARNING: USE AT YOUR OWN RISK ⚠️"
echo "This script will update ShieldPM in-place by pulling the latest code"
echo "and rebuilding the application. Unexpected issues may occur."
echo "Always backup your data before proceeding!"
echo ""
read -p "Are you sure you want to continue? [y/N] " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Update aborted."
    exit 1
fi
echo "--> Checking for application updates..."
# Consume the complete response: grep | head can terminate the updater with SIGPIPE.
if ! BRANCH_ENCODED=$(node -p 'encodeURIComponent(process.argv[1])' "$BRANCH"); then
    echo "Could not run Node.js for the update check. No application files were changed."
    exit 1
fi
if ! LATEST_SHA_FULL=$(curl -fsSL --connect-timeout 10 --max-time 60 \
    "https://api.github.com/repos/shedowe19/ShieldPM/commits/$BRANCH_ENCODED" | \
    node --input-type=module -e 'let data = ""; for await (const chunk of process.stdin) data += chunk; try { console.log(JSON.parse(data).sha || ""); } catch { process.exitCode = 1; }'); then
    echo "Could not resolve branch $BRANCH. Check network access, the branch name and GitHub API rate limits."
    echo "No application files were changed."
    exit 1
fi
if [[ ! "$LATEST_SHA_FULL" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Could not resolve branch $BRANCH. No application files were changed."
    exit 1
fi
LATEST_SHORT=${LATEST_SHA_FULL:0:7}

# Get local commit hash if available
if [ -f "/app/.git-commit" ]; then
    CURRENT_SHA=$(cat /app/.git-commit)
    CURRENT_SHORT=${CURRENT_SHA:0:7}
else
    CURRENT_SHORT="unknown"
    CURRENT_SHA=""
fi

# Get semantic version for display
if [ -f "/app/package.json" ]; then
    CURRENT_VER=$(node --input-type=module -e 'import fs from "node:fs"; try { console.log(JSON.parse(fs.readFileSync(process.argv[1], "utf8")).version || "unknown"); } catch { console.log("unknown"); }' /app/package.json)
else
    CURRENT_VER="unknown"
fi

echo "    Current Version: $CURRENT_VER ($CURRENT_SHORT)"
echo "    Latest Commit:   $LATEST_SHORT (Branch: $BRANCH)"
echo ""

if [[ "$CURRENT_SHA" == "$LATEST_SHA_FULL" ]]; then
    echo "✅ You are already on the latest commit!"
    read -p "Force update anyway? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Update cancelled."
        exit 0
    fi
fi

# Self-Update: Fetch latest version of this script first
echo "--> [0/9] Checking for script updates..."
# Follow the selected target, never replace a feature-branch fix with develop's updater.
SCRIPT_URL="https://raw.githubusercontent.com/shedowe19/ShieldPM/${LATEST_SHA_FULL}/rootfs/usr/local/bin/update-shieldpm"
SCRIPT_TMP="$UPDATE_RUN_DIR/update-shieldpm.new"
SCRIPT_CURRENT="/usr/local/bin/update-shieldpm"

# Allow curl to fail (e.g. if offline or github issues) without crashing the script (set -e)
if [[ "${SHIELDPM_SELF_UPDATED:-0}" != "1" ]] && \
    curl -fsSL --connect-timeout 10 --max-time 60 -o "$SCRIPT_TMP" "$SCRIPT_URL" && bash -n "$SCRIPT_TMP"; then
    # Compare with current script
    if ! cmp -s "$SCRIPT_TMP" "$SCRIPT_CURRENT"; then
        echo "    - New version found. Updating self and restarting..."
        cp "$SCRIPT_TMP" "$SCRIPT_CURRENT"
        chmod +x "$SCRIPT_CURRENT"
        rm -f "$SCRIPT_TMP"
        # Re-execute with same arguments, but mark as already self-updated
        export SHIELDPM_SELF_UPDATED=1
        rm -rf "$UPDATE_RUN_DIR"
        exec /bin/bash "$SCRIPT_CURRENT" "${ORIGINAL_ARGS[@]}"
    else
        echo "    - Script is up to date."
        rm -f "$SCRIPT_TMP"
    fi
else
    echo "    - Could not fetch latest script (continuing anyway)."
fi

enable_node_system_ca() {
    if [[ " ${NODE_OPTIONS:-} " != *" --use-system-ca "* ]]; then
        export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--use-system-ca"
    fi
}

remove_stale_corepack_shims() {
    local shim
    local shim_target

    for shim in /usr/bin/corepack /usr/bin/yarn /usr/bin/yarnpkg /usr/bin/pnpm /usr/bin/pnpx; do
        [ -L "$shim" ] || continue
        shim_target="$(readlink "$shim")"
        case "$shim_target" in
            *corepack/dist/*)
                rm -f "$shim"
                ;;
        esac
    done
}

wait_for_backend_health() {
    # Startup may spend 240s preparing GeoIP databases, followed by 120s for the backend.
    local deadline=$((SECONDS + 360))

    echo "    - Waiting for the updated backend and database migrations..."
    while ((SECONDS < deadline)); do
        if curl --fail --silent --show-error --max-time 2 --unix-socket /run/shieldpm/shieldpm.sock \
            http://localhost/ 2>/dev/null | jq -e '.status == "OK"' >/dev/null; then
            echo "    - Backend is healthy; pending database migrations completed."
            return 0
        fi
        sleep 1
    done

    echo "    ! ShieldPM did not become healthy within 360s."
    return 1
}

confirm_database_recovery_checkpoint() {
    local checkpoint="$UPDATE_RUN_DIR/database-backup-checkpoint"
    local data_path="${DATA_PATH:-/data}"
    local sqlite_source="$data_path/shieldpm/database.sqlite"
    local sqlite_snapshot="$UPDATE_RUN_DIR/database-backup.sqlite"
    local external_database=false
    local original_umask
    local reply

    original_umask="$(umask)"

    if grep -qsE '^[[:space:]]*(export[[:space:]]+)?DB_(MYSQL|POSTGRES)_HOST=' "$data_path/.env"; then
        external_database=true
    elif [ -f "$data_path/shieldpm/default.json" ] && DATA_PATH="$data_path" node --input-type=module -e '
        import fs from "node:fs";
        const dataPath = process.env.DATA_PATH;
        try {
            const engine = JSON.parse(fs.readFileSync(dataPath + "/shieldpm/default.json", "utf8"))?.database?.engine;
            process.exit(["mysql", "mysql2", "pg"].includes(engine) ? 0 : 1);
        } catch {
            process.exit(1);
        }
    '; then
        external_database=true
    fi

    umask 077
    if [ "$external_database" = true ]; then
        echo "    ! An external database backup is required before files are swapped."
        read -r -p "    ? Confirm a current external database backup exists [y/N] " -n 1 reply
        echo ""
        if [[ ! $reply =~ ^[Yy]$ ]]; then
            umask "$original_umask"
            echo "    ! Update aborted before replacing application files."
            return 1
        fi
        printf 'database_kind=external\nbackup_confirmed_at=%s\n' "$(date -Is)" > "$checkpoint"
        umask "$original_umask"
        echo "    - External database backup checkpoint recorded."
        return 0
    fi

    if [ -s "$sqlite_source" ]; then
        if ! python3 - "$sqlite_source" "$sqlite_snapshot" <<'PY'
import sqlite3
import sys
from pathlib import Path

source_path, target_path = sys.argv[1:]
source = sqlite3.connect(f"{Path(source_path).resolve().as_uri()}?mode=ro", uri=True)
target = sqlite3.connect(target_path)
try:
    source.backup(target)
finally:
    target.close()
    source.close()
PY
        then
            umask "$original_umask"
            echo "    ! SQLite recovery snapshot failed; no application files were replaced."
            return 1
        fi
        chmod 600 "$sqlite_snapshot"
        printf 'database_kind=sqlite\nsnapshot=%s\ncreated_at=%s\n' "$sqlite_snapshot" "$(date -Is)" > "$checkpoint"
        umask "$original_umask"
        echo "    - SQLite recovery snapshot created."
        return 0
    fi

    printf 'database_kind=none\ncreated_at=%s\n' "$(date -Is)" > "$checkpoint"
    umask "$original_umask"
    echo "    - No local database snapshot was required."
}

install_node_26() {
    local NODE_MAJOR=26
    local NODESOURCE_KEYRING="/etc/apt/keyrings/nodesource.gpg"
    local NODESOURCE_LIST="/etc/apt/sources.list.d/nodesource.list"
    local NODE_PACKAGE_VERSION
    local NODE_VERSION
    local source_file

    echo "--> Installing Node.js ${NODE_MAJOR} build runtime..."
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg

    install -d -m 0755 /etc/apt/keyrings
    curl -fsSL "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key" | \
        gpg --dearmor --yes --output "$NODESOURCE_KEYRING"
    chmod a+r "$NODESOURCE_KEYRING"

    # An existing NodeSource major would otherwise win apt's version selection
    # and prevent the intended Node 26 installation.
    while IFS= read -r -d '' source_file; do
        if grep -qE 'deb[.]nodesource[.]com/node_[0-9]+[.]x' "$source_file"; then
            rm -f "$source_file"
        fi
    done < <(find /etc/apt/sources.list.d -maxdepth 1 -type f \( -name '*.list' -o -name '*.sources' \) -print0)

    printf 'deb [signed-by=%s] https://deb.nodesource.com/node_%s.x nodistro main\n' \
        "$NODESOURCE_KEYRING" "$NODE_MAJOR" > "$NODESOURCE_LIST"
    apt-get update
    # With pipefail, awk must consume the complete listing; exiting early can make apt-cache fail with SIGPIPE.
    NODE_PACKAGE_VERSION="$(apt-cache madison nodejs | awk '$3 ~ /^26\./ && !found { print $3; found = 1 }')"
    if [ -z "$NODE_PACKAGE_VERSION" ]; then
        echo "    ! NodeSource does not provide a Node.js ${NODE_MAJOR} package for this architecture."
        exit 1
    fi
    DEBIAN_FRONTEND=noninteractive apt-get install -y --allow-downgrades \
        "nodejs=${NODE_PACKAGE_VERSION}"

    enable_node_system_ca
    COREPACK_BIN="$(command -v corepack || true)"
    if [ -n "$COREPACK_BIN" ] && [ -x "$COREPACK_BIN" ]; then
        corepack enable
        corepack install --global yarn@1.22.22
    else
        remove_stale_corepack_shims
        npm install --global --allow-scripts=yarn yarn@1.22.22
    fi

    NODE_VERSION="$(node --version)"
    if [[ ! "$NODE_VERSION" =~ ^v26\. ]]; then
        echo "    ! Node.js 26 installation failed; active version is $NODE_VERSION."
        exit 1
    fi

    echo "    - Node.js $NODE_VERSION, npm $(npm --version), Yarn $(yarn --version)"
}

stage_native_binaries() {
    local helper="$TEMP_DIR/rootfs/usr/local/bin/stage-native-binaries.py"
    local release_base="https://github.com/shedowe19/ShieldPM/releases/download/nginx-binaries"
    local version url member
    local stage="$UPDATE_RUN_DIR/binaries"

    STAGED_NGINX=false
    STAGED_ANUBIS=false
    STAGED_OAUTH2=false
    ANUBIS_INSTALLED=false
    [ ! -f /usr/local/bin/anubis ] || ANUBIS_INSTALLED=true
    ARCH=$(dpkg --print-architecture)
    mkdir -p "$stage"
    if [[ "$ARCH" != amd64 && "$ARCH" != arm64 ]]; then
        echo "    - Skipping native binary updates: Architecture $ARCH not supported."
        return 0
    fi
    if [ ! -f "$helper" ]; then
        echo "Missing native archive preflight helper; no application files were changed." >&2
        return 1
    fi

    echo "--> [5/9] Preparing Nginx Binary Updates..."
    read -p "    ? Update compiled Nginx binaries? (Recommended) [Y/n] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Nn]$ ]]; then
        curl --fail --location --connect-timeout 10 --max-time 900 --retry 2 --retry-max-time 900 \
            -o "$stage/nginx.tar.gz" "$release_base/nginx-linux-$ARCH.tar.gz"
        python3 "$helper" nginx "$stage/nginx.tar.gz" "$stage/nginx" "$ARCH"
        STAGED_NGINX=true
    fi

    echo "--> [6/9] Preparing Anubis AI Firewall Updates..."
    if [ "$ANUBIS_INSTALLED" = true ]; then
        read -p "    ? Update Anubis binary? [Y/n] " -n 1 -r
    else
        read -p "    ? Install Anubis AI Firewall? [y/N] " -n 1 -r
    fi
    echo ""
    if { [ "$ANUBIS_INSTALLED" = true ] && [[ ! $REPLY =~ ^[Nn]$ ]]; } || \
        { [ "$ANUBIS_INSTALLED" = false ] && [[ $REPLY =~ ^[Yy]$ ]]; }; then
        version=1.27.0
        member="anubis-$version-linux-$ARCH/bin/anubis"
        url="https://github.com/TecharoHQ/anubis/releases/download/v$version/anubis-$version-linux-$ARCH.tar.gz"
        curl --fail --location --connect-timeout 10 --max-time 900 --retry 2 --retry-max-time 900 \
            -o "$stage/anubis.tar.gz" "$url"
        python3 "$helper" binary "$stage/anubis.tar.gz" "$stage/anubis" "$ARCH" "$member"
        STAGED_ANUBIS=true
    fi

    echo "--> [7/9] Preparing OAuth2 Proxy Updates..."
    if [ -f /usr/local/bin/oauth2-proxy ]; then
        read -p "    ? Update OAuth2 Proxy binary? [Y/n] " -n 1 -r
    else
        read -p "    ? Install OAuth2 Proxy? [y/N] " -n 1 -r
    fi
    echo ""
    if { [ -f /usr/local/bin/oauth2-proxy ] && [[ ! $REPLY =~ ^[Nn]$ ]]; } || \
        { [ ! -f /usr/local/bin/oauth2-proxy ] && [[ $REPLY =~ ^[Yy]$ ]]; }; then
        version=7.15.3
        member="oauth2-proxy-v$version.linux-$ARCH/oauth2-proxy"
        url="https://github.com/oauth2-proxy/oauth2-proxy/releases/download/v$version/oauth2-proxy-v$version.linux-$ARCH.tar.gz"
        curl --fail --location --connect-timeout 10 --max-time 900 --retry 2 --retry-max-time 900 \
            -o "$stage/oauth2-proxy.tar.gz" "$url"
        python3 "$helper" binary "$stage/oauth2-proxy.tar.gz" "$stage/oauth2-proxy" "$ARCH" "$member"
        STAGED_OAUTH2=true
    fi
}

apply_staged_native_binaries() {
    local stage="$UPDATE_RUN_DIR/binaries"
    if [ "$STAGED_NGINX" = true ]; then
        cp -a "$stage/nginx/usr/." /usr/
        ldconfig
        echo "    - Prepared Nginx binaries installed."
    fi
    if [ "$STAGED_ANUBIS" = true ]; then
        install -m 755 "$stage/anubis" /usr/local/bin/anubis
        if [ "$ANUBIS_INSTALLED" = false ]; then
            ENV_FILE="/data/.env"
            if [ -f "$ENV_FILE" ]; then
                    if grep -qE '^[[:space:]]*(#[[:space:]]*)?(export[[:space:]]+)?ANUBIS_ENABLED=' "$ENV_FILE"; then
                        sed -i -E 's|^[[:space:]]*(#[[:space:]]*)?(export[[:space:]]+)?ANUBIS_ENABLED=.*$|ANUBIS_ENABLED=true|' "$ENV_FILE"
                    else
                        echo "ANUBIS_ENABLED=true" >> "$ENV_FILE"
                    fi
            fi
        fi
        echo "    - Prepared Anubis binary installed."
    fi
    if [ "$STAGED_OAUTH2" = true ]; then
        install -m 755 "$stage/oauth2-proxy" /usr/local/bin/oauth2-proxy
        echo "    - Prepared OAuth2 Proxy binary installed."
    fi
}

echo "--> [1/9] Updating System & Dependencies..."

apt-get update
# Upgrade all packages to keep the system secure
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y

install_node_26

apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    libffi-dev \
    gyp \
    jq \
    mariadb-client \
    postgresql-client

echo "--> [2/9] Fetching latest source..."
git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$TEMP_DIR"
# The branch may advance between the initial lookup and clone.
LATEST_SHA_FULL=$(git -C "$TEMP_DIR" rev-parse HEAD)

echo "--> [3/9] Building Backend..."
cd "$TEMP_DIR/backend"
# LXC compatible: Run as root
# Fix for node-gyp on Python 3.13: Ensure dist-packages is in python path
export PYTHONPATH="/usr/lib/python3/dist-packages:${PYTHONPATH:-}"
yarn install --frozen-lockfile --production --silent

echo "--> [4/9] Building Frontend..."
cd "$TEMP_DIR/frontend"
# LXC compatible: Run as root
yarn install --frozen-lockfile --production=false --silent
yarn run build

# Complete every prompt, transfer and archive check while the old service runs.
stage_native_binaries

if ! confirm_database_recovery_checkpoint; then
    exit 1
fi

echo "--> [8/9] Swapping files..."
# Preserve a recoverable copy before stopping the service. Rollback is disabled
# once the new backend starts because migrations may change the database schema.
cp -a "$BACKEND_DIR" "$UPDATE_RUN_DIR/backend-backup"
cp -a "$FRONTEND_DIR" "$UPDATE_RUN_DIR/frontend-backup"
# Do not serve a mixture of old modules and new files during replacement.
systemctl stop shieldpm
UPDATE_ROLLBACK=true
# Backend
echo "    - Updating Backend at $BACKEND_DIR..."
# Application state belongs in /data. Replacing /app exactly prevents removed
# source files or native modules from surviving a release update.
mkdir -p "$BACKEND_DIR"
find "$BACKEND_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cp -a "$TEMP_DIR/backend/." "$BACKEND_DIR/"
printf '%s\n' "$LATEST_SHA_FULL" > "$BACKEND_DIR/.git-commit"

# Frontend
echo "    - Updating Frontend at $FRONTEND_DIR..."
mkdir -p "$FRONTEND_DIR"
find "$FRONTEND_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cp -a "$TEMP_DIR/frontend/dist/." "$FRONTEND_DIR/"

# Rootfs (System Scripts & Configs)
echo "    - Updating System Configs (rootfs)..."
# SAFETY: Remove /data from the update payload to PREVENT overwriting user config (.env) and database
rm -rf "$TEMP_DIR/rootfs/data"
cp -rf "$TEMP_DIR/rootfs/"* /

# Only prepared local files are installed while ShieldPM is stopped.
apply_staged_native_binaries

echo "--> [9/9] Restarting ShieldPM and applying database migrations..."
systemctl daemon-reload
UPDATE_ROLLBACK=false
if systemctl restart shieldpm && systemctl is-active --quiet shieldpm && wait_for_backend_health; then
    echo "    - ShieldPM is running; application update and database migrations are healthy."
else
    echo "    ! ShieldPM did not become healthy after the update."
    systemctl --no-pager --full status shieldpm || true
    journalctl --no-pager -u shieldpm -n 100 || true
    exit 1
fi

echo "--> Cleanup..."
rm -rf "$TEMP_DIR"
# Optional: remove build tools to save space?
# apt-get remove -y git build-essential ...
# apt-get autoremove -y

echo "=========================================="
echo "✅ Update Complete!"
echo "=========================================="
