#!/bin/bash
set -euo pipefail

# Self-update protection: Run from /tmp to allow overwriting the original script file
SELF_PATH=$(readlink -f "$0")
if [[ "$SELF_PATH" != "/tmp/shieldpm_update_running" ]]; then
    cp "$SELF_PATH" /tmp/shieldpm_update_running
    exec /bin/bash /tmp/shieldpm_update_running "$@"
fi

# Only run as root
if [ "$EUID" -ne 0 ]; then
  echo "Please run as root"
  exit 1
fi

REPO_URL="https://github.com/shedowe19/ShieldPM.git"

BRANCH="develop" # Default branch for content
SCRIPT_BRANCH="develop" # Always pull the updater from develop/master to avoid breaking on feature branches

# Preserve original arguments for self-update restart
ORIGINAL_ARGS=("$@")

# Argument Parsing
while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--branch)
      BRANCH="$2"
      shift # past argument
      shift # past value
      ;;
    *)
      shift # past argument
      ;;
  esac
done

TEMP_DIR="/tmp/shieldpm_update_$(date +%s)"
BACKEND_DIR="/app"
FRONTEND_DIR="/html/frontend"

echo "=========================================="
echo "🛡️ ShieldPM In-Place Update Utility"
echo "=========================================="
echo "Target Branch: $BRANCH"
echo "Temp Dir:      $TEMP_DIR"
echo "Binary Tag:    nginx-binaries (Rolling)"
echo "=========================================="

echo ""
echo "⚠️  WARNING: USE AT YOUR OWN RISK ⚠️"
echo "This script will update ShieldPM in-place by pulling the latest code"
echo "and rebuilding the application. Unexpected issues may occur."
echo "Always backup your data before proceeding!"
echo ""
read -p "Are you sure you want to continue? [y/N] " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Update aborted."
    exit 1
fi
echo "--> Checking for application updates..."
# Fetch latest commit SHA for the target branch
LATEST_SHA_FULL=$(curl -s "https://api.github.com/repos/shedowe19/ShieldPM/commits/$BRANCH" | grep '"sha":' | head -n 1 | cut -d '"' -f 4)
LATEST_SHORT=${LATEST_SHA_FULL:0:7}

# Get local commit hash if available
if [ -f "/app/.git-commit" ]; then
    CURRENT_SHA=$(cat /app/.git-commit)
    CURRENT_SHORT=${CURRENT_SHA:0:7}
else
    CURRENT_SHORT="unknown"
    CURRENT_SHA=""
fi

# Get semantic version for display
if [ -f "/app/package.json" ]; then
    CURRENT_VER=$(grep '"version":' /app/package.json | head -n 1 | cut -d '"' -f 4)
else
    CURRENT_VER="unknown"
fi

echo "    Current Version: $CURRENT_VER ($CURRENT_SHORT)"
echo "    Latest Commit:   $LATEST_SHORT (Branch: $BRANCH)"
echo ""

if [[ "$CURRENT_SHA" == "$LATEST_SHA_FULL" ]]; then
    echo "✅ You are already on the latest commit!"
    read -p "Force update anyway? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Update cancelled."
        exit 0
    fi
fi

# Self-Update: Fetch latest version of this script first
echo "--> [0/9] Checking for script updates..."
SCRIPT_URL="https://raw.githubusercontent.com/shedowe19/ShieldPM/${SCRIPT_BRANCH}/rootfs/usr/local/bin/update-shieldpm"
SCRIPT_TMP="/tmp/update-shieldpm.new"
SCRIPT_CURRENT="/usr/local/bin/update-shieldpm"

# Allow curl to fail (e.g. if offline or github issues) without crashing the script (set -e)
if curl -sfL -o "$SCRIPT_TMP" "$SCRIPT_URL" && [ -f "$SCRIPT_TMP" ]; then
    # Compare with current script
    if ! cmp -s "$SCRIPT_TMP" "$SCRIPT_CURRENT"; then
        echo "    - New version found. Updating self and restarting..."
        cp "$SCRIPT_TMP" "$SCRIPT_CURRENT"
        chmod +x "$SCRIPT_CURRENT"
        rm -f "$SCRIPT_TMP"
        # Re-execute with same arguments, but mark as already self-updated
        export SHIELDPM_SELF_UPDATED=1
        exec /bin/bash "$SCRIPT_CURRENT" "${ORIGINAL_ARGS[@]}"
    else
        echo "    - Script is up to date."
        rm -f "$SCRIPT_TMP"
    fi
else
    echo "    - Could not fetch latest script (continuing anyway)."
fi

enable_node_system_ca() {
    if [[ " ${NODE_OPTIONS:-} " != *" --use-system-ca "* ]]; then
        export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--use-system-ca"
    fi
}

remove_stale_corepack_shims() {
    local shim
    local shim_target

    for shim in /usr/bin/corepack /usr/bin/yarn /usr/bin/yarnpkg /usr/bin/pnpm /usr/bin/pnpx; do
        [ -L "$shim" ] || continue
        shim_target="$(readlink "$shim")"
        case "$shim_target" in
            *corepack/dist/*)
                rm -f "$shim"
                ;;
        esac
    done
}

wait_for_backend_health() {
    local attempt
    local max_attempts=120

    echo "    - Waiting for the updated backend and database migrations..."
    for ((attempt = 1; attempt <= max_attempts; attempt++)); do
        if curl --fail --silent --show-error --unix-socket /run/shieldpm.sock \
            http://localhost/ 2>/dev/null | jq -e '.status == "OK"' >/dev/null; then
            echo "    - Backend is healthy; pending database migrations completed."
            return 0
        fi
        sleep 1
    done

    echo "    ! ShieldPM did not become healthy within ${max_attempts}s."
    return 1
}

install_node_26() {
    local NODE_MAJOR=26
    local NODESOURCE_KEYRING="/etc/apt/keyrings/nodesource.gpg"
    local NODESOURCE_LIST="/etc/apt/sources.list.d/nodesource.list"
    local NODE_PACKAGE_VERSION
    local NODE_VERSION
    local source_file

    echo "--> Installing Node.js ${NODE_MAJOR} build runtime..."
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg

    install -d -m 0755 /etc/apt/keyrings
    curl -fsSL "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key" | \
        gpg --dearmor --yes --output "$NODESOURCE_KEYRING"
    chmod a+r "$NODESOURCE_KEYRING"

    # An existing NodeSource major would otherwise win apt's version selection
    # and prevent the intended Node 26 installation.
    while IFS= read -r -d '' source_file; do
        if grep -qE 'deb[.]nodesource[.]com/node_[0-9]+[.]x' "$source_file"; then
            rm -f "$source_file"
        fi
    done < <(find /etc/apt/sources.list.d -maxdepth 1 -type f \( -name '*.list' -o -name '*.sources' \) -print0)

    printf 'deb [signed-by=%s] https://deb.nodesource.com/node_%s.x nodistro main\n' \
        "$NODESOURCE_KEYRING" "$NODE_MAJOR" > "$NODESOURCE_LIST"
    apt-get update
    # With pipefail, awk must consume the complete listing; exiting early can make apt-cache fail with SIGPIPE.
    NODE_PACKAGE_VERSION="$(apt-cache madison nodejs | awk '$3 ~ /^26\./ && !found { print $3; found = 1 }')"
    if [ -z "$NODE_PACKAGE_VERSION" ]; then
        echo "    ! NodeSource does not provide a Node.js ${NODE_MAJOR} package for this architecture."
        exit 1
    fi
    DEBIAN_FRONTEND=noninteractive apt-get install -y --allow-downgrades \
        "nodejs=${NODE_PACKAGE_VERSION}"

    enable_node_system_ca
    COREPACK_BIN="$(command -v corepack || true)"
    if [ -n "$COREPACK_BIN" ] && [ -x "$COREPACK_BIN" ]; then
        corepack enable
        corepack install --global yarn@1.22.22
    else
        remove_stale_corepack_shims
        npm install --global --allow-scripts=yarn yarn@1.22.22
    fi

    NODE_VERSION="$(node --version)"
    if [[ ! "$NODE_VERSION" =~ ^v26\. ]]; then
        echo "    ! Node.js 26 installation failed; active version is $NODE_VERSION."
        exit 1
    fi

    echo "    - Node.js $NODE_VERSION, npm $(npm --version), Yarn $(yarn --version)"
}

echo "--> [1/9] Updating System & Dependencies..."

apt-get update
# Upgrade all packages to keep the system secure
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y

install_node_26

apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    libffi-dev \
    gyp \
    jq

echo "--> [2/9] Fetching latest source..."
git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$TEMP_DIR"

echo "--> [3/9] Building Backend..."
cd "$TEMP_DIR/backend"
# LXC compatible: Run as root
# Fix for node-gyp on Python 3.13: Ensure dist-packages is in python path
export PYTHONPATH="/usr/lib/python3/dist-packages:${PYTHONPATH:-}"
yarn install --frozen-lockfile --production --silent

echo "--> [4/9] Building Frontend..."
cd "$TEMP_DIR/frontend"
# LXC compatible: Run as root
yarn install --frozen-lockfile --silent
yarn run build

echo "--> [5/9] Swapping files..."
# Backend
echo "    - Updating Backend at $BACKEND_DIR..."
# Application state belongs in /data. Replacing /app exactly prevents removed
# source files or native modules from surviving a release update.
mkdir -p "$BACKEND_DIR"
find "$BACKEND_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cp -a "$TEMP_DIR/backend/." "$BACKEND_DIR/"
printf '%s\n' "$LATEST_SHA_FULL" > "$BACKEND_DIR/.git-commit"

# Frontend
echo "    - Updating Frontend at $FRONTEND_DIR..."
mkdir -p "$FRONTEND_DIR"
find "$FRONTEND_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cp -a "$TEMP_DIR/frontend/dist/." "$FRONTEND_DIR/"

# Rootfs (System Scripts & Configs)
echo "    - Updating System Configs (rootfs)..."
# SAFETY: Remove /data from the update payload to PREVENT overwriting user config (.env) and database
rm -rf "$TEMP_DIR/rootfs/data"
cp -rf "$TEMP_DIR/rootfs/"* /

echo "--> [6/9] Checking for Nginx Binary Updates..."
RELEASE_BASE="https://github.com/shedowe19/ShieldPM/releases/download/nginx-binaries"
ARCH=$(dpkg --print-architecture)

if [[ "$ARCH" == "amd64" || "$ARCH" == "arm64" ]]; then
    # Simple prompt, defaulting to Yes for convenience
    read -p "    ? Update compiled Nginx binaries? (Recommended) [Y/n] " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Nn]$ ]]; then
         echo "    - Skipping binary update."
    else
         echo "    - Downloading nginx-linux-$ARCH.tar.gz..."
         curl -L -f -o "$TEMP_DIR/nginx.tar.gz" "$RELEASE_BASE/nginx-linux-$ARCH.tar.gz"
         if [ -f "$TEMP_DIR/nginx.tar.gz" ]; then
             echo "    - Extracting binaries..."
             tar -xzf "$TEMP_DIR/nginx.tar.gz" -C /
             echo "    - Binaries updated successfully."
         else
             echo "    ! Failed to download binaries. Please check internet connection or GitHub status."
         fi
    fi
else
    echo "    - Skipping Nginx update: Architecture $ARCH not supported for auto-update."
fi

echo "--> [7/9] Checking for Anubis AI Firewall Updates..."
# Check if Anubis is installed or enabled
ANUBIS_INSTALLED=false
if [ -f "/usr/local/bin/anubis" ]; then
    ANUBIS_INSTALLED=true
fi

# Detect Arch for Anubis (reuse ARCH from nginx step if valid, else re-detect)
# Anubis uses "amd64" / "arm64" suffix
ANUBIS_ARCH=""
if [[ "$ARCH" == "amd64" ]]; then
    ANUBIS_ARCH="amd64"
elif [[ "$ARCH" == "arm64" ]]; then
    ANUBIS_ARCH="arm64"
fi

if [[ -n "$ANUBIS_ARCH" ]]; then
    SHOULD_UPDATE=false

    if [ "$ANUBIS_INSTALLED" = true ]; then
        echo "    - Anubis is installed."
        read -p "    ? Update Anubis binary? [Y/n] " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            SHOULD_UPDATE=true
        fi
    else
        echo "    - Anubis is NOT installed."
        read -p "    ? Install Anubis AI Firewall? [y/N] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            SHOULD_UPDATE=true
        fi
    fi

    if [ "$SHOULD_UPDATE" = true ]; then
        ANUBIS_VERSION="1.27.0"
        ANUBIS_URL="https://github.com/TecharoHQ/anubis/releases/download/v${ANUBIS_VERSION}/anubis-${ANUBIS_VERSION}-linux-${ANUBIS_ARCH}.tar.gz"
        echo "    - Downloading Anubis $ANUBIS_VERSION ($ANUBIS_ARCH)..."
        curl -L -f -o /tmp/anubis.tar.gz "$ANUBIS_URL"
        if [ -s /tmp/anubis.tar.gz ]; then
            tar -xzf /tmp/anubis.tar.gz -C /usr/local/bin --strip-components=2 "anubis-${ANUBIS_VERSION}-linux-${ANUBIS_ARCH}/bin/anubis"
            rm /tmp/anubis.tar.gz
            chmod +x /usr/local/bin/anubis
            echo "    - Anubis installed successfully."

            # Ensure enabled in env if installing fresh
            if [ "$ANUBIS_INSTALLED" = false ]; then
                ENV_FILE="/data/.env"
                if [ -f "$ENV_FILE" ]; then
                    if grep -q "ANUBIS_ENABLED" "$ENV_FILE"; then
                        sed -i "s|.*ANUBIS_ENABLED.*|ANUBIS_ENABLED=true|g" "$ENV_FILE"
                    else
                        echo "ANUBIS_ENABLED=true" >> "$ENV_FILE"
                    fi
                    echo "    - Enabled Anubis in $ENV_FILE"
                fi
            fi
        else
            echo "    ! Failed to download Anubis. Check internet connection."
        fi
    else
        echo "    - Skipping Anubis update/install."
    fi
else
    echo "    - Skipping Anubis: Architecture $ARCH not supported."
fi

echo "--> [8/9] Checking for OAuth2 Proxy Updates..."
# Check if OAuth2 Proxy is installed
OAUTH2_INSTALLED=false
if [ -f "/usr/local/bin/oauth2-proxy" ]; then
    OAUTH2_INSTALLED=true
fi

# Detect Arch for OAuth2 Proxy (reuse ARCH from nginx step if valid, else re-detect)
# OAuth2 Proxy uses "amd64" / "arm64" suffix
OAUTH2_ARCH=""
if [[ "$ARCH" == "amd64" ]]; then
    OAUTH2_ARCH="amd64"
elif [[ "$ARCH" == "arm64" ]]; then
    OAUTH2_ARCH="arm64"
fi

if [[ -n "$OAUTH2_ARCH" ]]; then
    SHOULD_UPDATE_OAUTH2=false

    if [ "$OAUTH2_INSTALLED" = true ]; then
        echo "    - OAuth2 Proxy is installed."
        read -p "    ? Update OAuth2 Proxy binary? [Y/n] " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            SHOULD_UPDATE_OAUTH2=true
        fi
    else
        echo "    - OAuth2 Proxy is NOT installed."
        read -p "    ? Install OAuth2 Proxy? [y/N] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            SHOULD_UPDATE_OAUTH2=true
        fi
    fi

    if [ "$SHOULD_UPDATE_OAUTH2" = true ]; then
        OAUTH2_VERSION="7.15.3"
        OAUTH2_TARBALL="oauth2-proxy-v${OAUTH2_VERSION}.linux-${OAUTH2_ARCH}.tar.gz"
        OAUTH2_URL="https://github.com/oauth2-proxy/oauth2-proxy/releases/download/v${OAUTH2_VERSION}/${OAUTH2_TARBALL}"
        
        OAUTH2_TMP_DIR=$(mktemp -d)
        OAUTH2_TAR="$OAUTH2_TMP_DIR/$OAUTH2_TARBALL"

        echo "    - Downloading OAuth2 Proxy $OAUTH2_VERSION ($OAUTH2_ARCH)..."
        curl -L -f -o "$OAUTH2_TAR" "$OAUTH2_URL" || true

        if [ -s "$OAUTH2_TAR" ]; then
            cd "$OAUTH2_TMP_DIR"
            if tar -xzf "$OAUTH2_TARBALL"; then
                # Check if extracted binary exists before moving
                EXTRACTED_BIN="oauth2-proxy-v${OAUTH2_VERSION}.linux-${OAUTH2_ARCH}/oauth2-proxy"
                if [ -f "$EXTRACTED_BIN" ]; then
                    mv "$EXTRACTED_BIN" /usr/local/bin/oauth2-proxy
                    chmod +x /usr/local/bin/oauth2-proxy
                    echo "    - OAuth2 Proxy installed successfully."
                else
                    echo "    ! Failed to locate extracted OAuth2 Proxy binary."
                fi
            else
                echo "    ! Failed to extract OAuth2 Proxy."
            fi
            cd - > /dev/null
        else
            echo "    ! Failed to download OAuth2 Proxy or checksum. Check internet connection."
        fi
        rm -rf "$OAUTH2_TMP_DIR"
    else
        echo "    - Skipping OAuth2 Proxy update/install."
    fi
else
    echo "    - Skipping OAuth2 Proxy: Architecture $ARCH not supported."
fi

echo "--> [9/9] Restarting ShieldPM and applying database migrations..."
systemctl daemon-reload
if systemctl restart shieldpm && systemctl is-active --quiet shieldpm && wait_for_backend_health; then
    echo "    - ShieldPM is running; application update and database migrations are healthy."
else
    echo "    ! ShieldPM did not become healthy after the update."
    systemctl --no-pager --full status shieldpm || true
    journalctl --no-pager -u shieldpm -n 100 || true
    exit 1
fi

echo "--> Cleanup..."
rm -rf "$TEMP_DIR"
# Optional: remove build tools to save space?
# apt-get remove -y git build-essential ...
# apt-get autoremove -y

echo "=========================================="
echo "✅ Update Complete!"
echo "=========================================="
