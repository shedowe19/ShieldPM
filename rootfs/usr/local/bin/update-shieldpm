#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly REPOSITORY_URL="https://github.com/shedowe19/ShieldPM.git"
readonly BACKEND_DIR="/app"
readonly FRONTEND_DIR="/html/frontend"
readonly DATA_DIRECTORY="${DATA_PATH:-/data}"
readonly ENV_FILE="$DATA_DIRECTORY/.env"
readonly SQLITE_FILE="$DATA_DIRECTORY/shieldpm/database.sqlite"
readonly BACKUP_DIR="$DATA_DIRECTORY/shieldpm/backups"
readonly LOCK_DIRECTORY="/run/shieldpm-update"
readonly LOCK_FILE="$LOCK_DIRECTORY/update.lock"

BRANCH="develop"
EXTERNAL_DB_BACKUP_CONFIRMED=false
ASSUME_YES=false
TARGET_SHA=""
WORK_DIR=""
ROLLBACK_DIR=""
NEW_BACKEND=""
NEW_FRONTEND=""
OLD_BACKEND=""
OLD_FRONTEND=""
SQLITE_BACKUP=""
DATABASE_MODE="sqlite"
MUTATION_STARTED=false
SERVICE_STOPPED=false

usage() {
    cat <<'EOF'
Usage: update-shieldpm [-b|--branch BRANCH] [--external-db-backup-confirmed] [--yes]

The external database flag confirms that an operator-created, tested MySQL/PostgreSQL
backup exists. ShieldPM never pretends that copying local files backs up an external DB.
EOF
}

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

require_value() {
    [ "$#" -ge 2 ] && [ -n "$2" ] || fail "$1 requires a value"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -b|--branch)
            require_value "$@"
            BRANCH="$2"
            shift 2
            ;;
        --external-db-backup-confirmed)
            EXTERNAL_DB_BACKUP_CONFIRMED=true
            shift
            ;;
        --yes)
            ASSUME_YES=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *) fail "unknown option: $1" ;;
    esac
done

if [[ ! "$BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$ ]] ||
    [[ "$BRANCH" == *".."* || "$BRANCH" == *"//"* || "$BRANCH" == */ ]]; then
    fail "invalid branch name"
fi

[ "${EUID}" -eq 0 ] || fail "run as root"

for command in awk chmod corepack cp curl dirname find flock git grep install jq mkdir mktemp mv nginx node readlink rm rmdir sed sleep stat systemctl tail tar wc yarn; do
    command -v "$command" >/dev/null 2>&1 || fail "missing prerequisite: $command"
done

git check-ref-format --branch "$BRANCH" >/dev/null 2>&1 || fail "invalid Git branch name"

NODE_VERSION=$(node --version)
COREPACK_VERSION=$(corepack --version)
YARN_VERSION=$(yarn --version)
[[ "$NODE_VERSION" =~ ^v24\. ]] || fail "Node.js 24 is required; active version is $NODE_VERSION"
[ "$COREPACK_VERSION" = "0.36.0" ] || fail "Corepack 0.36.0 is required; active version is $COREPACK_VERSION"
[ "$YARN_VERSION" = "4.18.0" ] || fail "Yarn 4.18.0 is required; active version is $YARN_VERSION"

for target in "$BACKEND_DIR" "$FRONTEND_DIR"; do
    if [ -e "$target" ] || [ -L "$target" ]; then
        [ -d "$target" ] && [ ! -L "$target" ] || fail "unsafe application target: $target"
    fi
done

if [ -e "$LOCK_DIRECTORY" ] || [ -L "$LOCK_DIRECTORY" ]; then
    [ -d "$LOCK_DIRECTORY" ] && [ ! -L "$LOCK_DIRECTORY" ] || fail "unsafe updater lock directory"
    chmod 0700 "$LOCK_DIRECTORY"
else
    mkdir -m 0700 "$LOCK_DIRECTORY"
fi
[ ! -L "$LOCK_FILE" ] || fail "unsafe updater lock file"
exec 9>>"$LOCK_FILE"
chmod 0600 "$LOCK_FILE"
flock -n 9 || fail "another ShieldPM update is already running"

WORK_DIR=$(mktemp -d /tmp/shieldpm-update.XXXXXXXX)
install -d -m 0700 "$DATA_DIRECTORY/shieldpm"
ROLLBACK_DIR=$(mktemp -d "$DATA_DIRECTORY/shieldpm/update-rollback.XXXXXXXX")
NEW_BACKEND=$(mktemp -d "$(dirname "$BACKEND_DIR")/.shieldpm-app-new.XXXXXXXX")
NEW_FRONTEND=$(mktemp -d "$(dirname "$FRONTEND_DIR")/.shieldpm-frontend-new.XXXXXXXX")
OLD_BACKEND=$(mktemp -d "$(dirname "$BACKEND_DIR")/.shieldpm-app-old.XXXXXXXX")
OLD_FRONTEND=$(mktemp -d "$(dirname "$FRONTEND_DIR")/.shieldpm-frontend-old.XXXXXXXX")
rmdir "$OLD_BACKEND" "$OLD_FRONTEND"

cleanup() {
    rm -rf -- "$WORK_DIR" "$NEW_BACKEND" "$NEW_FRONTEND"
    if [ "$MUTATION_STARTED" = false ]; then
        rm -rf -- "$ROLLBACK_DIR" "$OLD_BACKEND" "$OLD_FRONTEND"
        if [ "$SERVICE_STOPPED" = true ]; then
            systemctl start shieldpm || true
        fi
    fi
}
trap cleanup EXIT

handle_error() {
    local status="$1"
    local line="$2"
    if [ "$MUTATION_STARTED" = true ]; then
        rollback "unexpected command failure at line $line (status $status)"
    fi
    exit "$status"
}
trap 'handle_error $? $LINENO' ERR

handle_signal() {
    local signal="$1"
    trap - ERR INT TERM
    if [ "$MUTATION_STARTED" = true ]; then
        rollback "received $signal"
    fi
    exit 130
}
trap 'handle_signal SIGINT' INT
trap 'handle_signal SIGTERM' TERM

echo "Resolving refs/heads/$BRANCH..."
REMOTE_LINE=$(git ls-remote --exit-code --heads "$REPOSITORY_URL" "refs/heads/$BRANCH") || fail "branch not found"
TARGET_SHA=$(awk 'NR == 1 { print $1 }' <<<"$REMOTE_LINE")
[[ "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "remote did not return an exact commit SHA"
[ "$(wc -l <<<"$REMOTE_LINE")" -eq 1 ] || fail "branch resolution was ambiguous"

git -C "$WORK_DIR" init --quiet
git -C "$WORK_DIR" remote add origin "$REPOSITORY_URL"
git -C "$WORK_DIR" fetch --quiet --depth=1 origin "$TARGET_SHA"
git -C "$WORK_DIR" checkout --quiet --detach "$TARGET_SHA"
[ "$(git -C "$WORK_DIR" rev-parse HEAD)" = "$TARGET_SHA" ] || fail "checked-out commit differs from resolved SHA"

TARGET_VERSION=$(<"$WORK_DIR/.version")
[[ "$TARGET_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || fail "invalid target version"
for manifest in backend/package.json frontend/package.json; do
    package_manager=$(jq -r '.packageManager // empty' "$WORK_DIR/$manifest")
    [ "$package_manager" = "yarn@4.18.0" ] || fail "$manifest must pin yarn@4.18.0 in packageManager"
    [ "$(jq -r '.version // empty' "$WORK_DIR/$manifest")" = "$TARGET_VERSION" ] || \
        fail "$manifest version must match .version"
done
grep -Eq '^[[:space:]]*enableScripts:[[:space:]]*false[[:space:]]*$' "$WORK_DIR/backend/.yarnrc.yml" || \
    fail "backend/.yarnrc.yml must disable dependency scripts by default"
jq -e '.dependenciesMeta["better-sqlite3"].built == true' "$WORK_DIR/backend/package.json" >/dev/null || \
    fail "backend/package.json must explicitly allow the better-sqlite3 native build"

echo "Building exact commit $TARGET_SHA..."
(
    cd "$WORK_DIR/backend"
    yarn install --immutable
    yarn workspaces focus --production
)
(
    cd "$WORK_DIR/frontend"
    yarn install --immutable
    yarn build
)

cp -a "$WORK_DIR/backend/." "$NEW_BACKEND/"
cp -a "$WORK_DIR/frontend/dist/." "$NEW_FRONTEND/"
printf '%s\n' "$TARGET_SHA" > "$NEW_BACKEND/.git-commit"

# Native-only binaries are supplied by the verified installer package. The updater
# deliberately preserves their exact bytes and never downloads or replaces runtimes.
for binary in anubis oauth2-proxy; do
    if [ -f "$BACKEND_DIR/$binary" ] && [ ! -L "$BACKEND_DIR/$binary" ]; then
        cp -a "$BACKEND_DIR/$binary" "$NEW_BACKEND/$binary"
    fi
done

[ "$(stat -c %d "$NEW_BACKEND")" = "$(stat -c %d "$(dirname "$BACKEND_DIR")")" ] || fail "backend staging is not on the target filesystem"
[ "$(stat -c %d "$NEW_FRONTEND")" = "$(stat -c %d "$(dirname "$FRONTEND_DIR")")" ] || fail "frontend staging is not on the target filesystem"

if grep -Eq '^[[:space:]]*(export[[:space:]]+)?DB_(MYSQL|POSTGRES)_HOST(_FILE)?=' "$ENV_FILE" 2>/dev/null; then
    DATABASE_MODE="external"
    [ "$EXTERNAL_DB_BACKUP_CONFIRMED" = true ] || fail "external DB detected; create and test a native DB backup, then pass --external-db-backup-confirmed"
elif [ -e "$SQLITE_FILE" ]; then
    [ -f "$SQLITE_FILE" ] && [ ! -L "$SQLITE_FILE" ] || fail "SQLite database is not a regular non-symlink file"
fi

if [ "$ASSUME_YES" != true ]; then
    printf 'Update ShieldPM to %s (%s)? [y/N] ' "$BRANCH" "${TARGET_SHA:0:12}"
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Update cancelled."; exit 0; }
fi

create_rootfs_snapshot() {
    : > "$ROLLBACK_DIR/rootfs-existing.list"
    : > "$ROLLBACK_DIR/rootfs-missing.list"
    while IFS= read -r -d '' source; do
        relative=${source#"$WORK_DIR/rootfs/"}
        case "$relative" in
            data|data/*) continue ;;
        esac
        target="/$relative"
        if [ -e "$target" ] || [ -L "$target" ]; then
            printf '%s\n' "$target" >> "$ROLLBACK_DIR/rootfs-existing.list"
        else
            printf '%s\n' "$target" >> "$ROLLBACK_DIR/rootfs-missing.list"
        fi
    done < <(find "$WORK_DIR/rootfs" \( -type f -o -type l \) -print0)

    if [ -s "$ROLLBACK_DIR/rootfs-existing.list" ]; then
        tar --create --preserve-permissions --absolute-names \
            --file "$ROLLBACK_DIR/rootfs.tar" --files-from "$ROLLBACK_DIR/rootfs-existing.list"
    else
        tar --create --file "$ROLLBACK_DIR/rootfs.tar" --files-from /dev/null
    fi
}

validate_rootfs_overlay() {
    while IFS= read -r -d '' source; do
        relative=${source#"$WORK_DIR/rootfs/"}
        case "$relative" in
            data|data/*) continue ;;
        esac
        case "$relative" in
            *$'\n'*|*$'\r'*) fail "unsafe control character in rootfs path" ;;
        esac
        case "/$relative" in
            *'/../'*|*'/./'*) fail "unsafe rootfs path: $relative" ;;
        esac
        if [ -L "$source" ]; then
            link_target=$(readlink "$source")
            case "$link_target" in
                ''|/*|..|../*|*/..|*/../*) fail "unsafe rootfs symlink: $relative" ;;
            esac
        fi
    done < <(find "$WORK_DIR/rootfs" \( -type f -o -type l \) -print0)
}

install_rootfs_overlay() {
    while IFS= read -r -d '' source; do
        relative=${source#"$WORK_DIR/rootfs/"}
        case "$relative" in
            data|data/*) continue ;;
        esac
        target="/$relative"
        install -d -m 0755 "$(dirname "$target")"
        staging="$(dirname "$target")/.shieldpm-new-$(basename "$target").$$"
        rm -f -- "$staging"
        if [ -L "$source" ]; then
            link_target=$(readlink "$source")
            case "$link_target" in
                ''|/*|..|../*|*/..|*/../*) fail "unsafe rootfs symlink: $relative" ;;
            esac
            ln -s "$link_target" "$staging"
        else
            cp -a "$source" "$staging"
        fi
        mv -Tf "$staging" "$target"
    done < <(find "$WORK_DIR/rootfs" \( -type f -o -type l \) -print0)
}

restore_rootfs_overlay() {
    local restore_ok=true
    while IFS= read -r target; do
        if [ -n "$target" ]; then
            rm -f -- "$target" || restore_ok=false
        fi
    done < "$ROLLBACK_DIR/rootfs-missing.list"
    tar --extract --preserve-permissions --absolute-names --file "$ROLLBACK_DIR/rootfs.tar" || restore_ok=false
    [ "$restore_ok" = true ]
}

frontend_port() {
    local value
    value=$(sed -n 's/^[[:space:]]*NPM_PORT=\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$ENV_FILE" 2>/dev/null | tail -n 1)
    printf '%s' "${value:-81}"
}

health_check() {
    systemctl is-active --quiet shieldpm || return 1
    curl --fail --silent --show-error --max-time 3 --unix-socket /run/shieldpm.sock \
        http://localhost/ | jq -e '.status == "OK"' >/dev/null || return 1
    nginx -tq >/dev/null 2>&1 || return 1
    [ -s "$FRONTEND_DIR/index.html" ] || return 1
    curl --fail --silent --show-error --max-time 3 "http://127.0.0.1:$(frontend_port)/" >/dev/null || return 1
}

wait_for_health() {
    local deadline=$((SECONDS + 120))
    until health_check; do
        [ "$SECONDS" -lt "$deadline" ] || return 1
        sleep 1
    done
}

rollback() {
    local reason="$1"
    local files_restored=true
    trap - ERR
    echo "Update failed: $reason" >&2
    systemctl stop shieldpm || true

    rm -rf -- "$BACKEND_DIR" || files_restored=false
    if [ -e "$OLD_BACKEND" ]; then
        mv -T "$OLD_BACKEND" "$BACKEND_DIR" || files_restored=false
    fi
    rm -rf -- "$FRONTEND_DIR" || files_restored=false
    if [ -e "$OLD_FRONTEND" ]; then
        mv -T "$OLD_FRONTEND" "$FRONTEND_DIR" || files_restored=false
    fi
    restore_rootfs_overlay || files_restored=false
    systemctl daemon-reload || files_restored=false

    if [ "$files_restored" != true ]; then
        echo "File rollback was incomplete; ShieldPM remains stopped. Recovery assets: $ROLLBACK_DIR" >&2
        exit 1
    fi

    if [ "$DATABASE_MODE" = "external" ]; then
        echo "External database migrations cannot be rolled back automatically." >&2
        echo "Files were restored, but ShieldPM is intentionally left STOPPED. Restore the external DB backup before starting it." >&2
        exit 1
    fi

    if [ -n "$SQLITE_BACKUP" ]; then
        node "$WORK_DIR/backend/scripts/sqlite-backup.js" --restore "$SQLITE_BACKUP" --destination "$SQLITE_FILE" || {
            echo "SQLite restore failed; ShieldPM remains stopped." >&2
            exit 1
        }
    fi

    systemctl start shieldpm || true
    if wait_for_health; then
        echo "Previous ShieldPM version and SQLite database were restored successfully." >&2
    else
        systemctl stop shieldpm || true
        echo "Rollback health verification failed; ShieldPM remains stopped." >&2
    fi
    exit 1
}

validate_rootfs_overlay
echo "Creating rollback snapshot and stopping ShieldPM..."
create_rootfs_snapshot
SERVICE_STOPPED=true
systemctl stop shieldpm

if [ "$DATABASE_MODE" = "sqlite" ] && [ -e "$SQLITE_FILE" ]; then
    SQLITE_BACKUP=$(node "$NEW_BACKEND/scripts/sqlite-backup.js" \
        --source "$SQLITE_FILE" --destination-directory "$BACKUP_DIR" --retention 7)
    [ -f "$SQLITE_BACKUP" ] || fail "verified SQLite backup was not created"
fi
MUTATION_STARTED=true

mkdir -p "$(dirname "$BACKEND_DIR")" "$(dirname "$FRONTEND_DIR")"
if [ -e "$BACKEND_DIR" ]; then mv -T "$BACKEND_DIR" "$OLD_BACKEND"; fi
if [ -e "$FRONTEND_DIR" ]; then mv -T "$FRONTEND_DIR" "$OLD_FRONTEND"; fi

mv -T "$NEW_BACKEND" "$BACKEND_DIR" || rollback "backend atomic swap failed"
mv -T "$NEW_FRONTEND" "$FRONTEND_DIR" || rollback "frontend atomic swap failed"
install_rootfs_overlay
systemctl daemon-reload || rollback "systemd reload failed"

systemctl start shieldpm || rollback "service start failed"
wait_for_health || rollback "120-second socket, HTTP, Nginx and frontend health gate failed"

rm -rf -- "$ROLLBACK_DIR" "$OLD_BACKEND" "$OLD_FRONTEND"
echo "ShieldPM update complete: $TARGET_SHA"
