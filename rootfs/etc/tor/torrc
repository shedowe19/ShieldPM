# ShieldPM Tor Configuration
# This file is used for Tor Onion Service (Hidden Service) management

# Disable SOCKS proxy - ShieldPM only uses Tor for Hidden Services
SocksPort 0

# Control Port for API access (localhost only)
ControlPort 127.0.0.1:9051

# Hashed password for control port authentication
# This placeholder is replaced at container startup by entrypoint.sh
HashedControlPassword __TOR_CONTROL_PASSWORD__

# Data directory for Tor state and Hidden Service keys
DataDirectory /data/tor

# Logging configuration
Log notice file /data/tor/tor.log

# Avoid IPv6 issues in container environments
ClientUseIPv6 0

# Don't run as relay or exit node
ExitRelay 0

# Hardware acceleration for crypto (if available)
HardwareAccel 1
