{
    "compilerOptions": {
        "module": "NodeNext",
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
        "checkJs": true,
        "strict": false,
        "moduleResolution": "NodeNext",
        "allowJs": true,
        "noEmit": true
    },
    "include": [
        "internal/**/*",
        "lib/**/*",
        "models/**/*"
    ]
}
