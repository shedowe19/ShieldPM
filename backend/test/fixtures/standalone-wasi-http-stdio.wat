;; Independent Preview 1 command: echo stdin exactly; an argument enables a
;; diagnostic prelude containing argv and the explicitly supplied environment.
;; There are no Proxy-Wasm imports, ABI exports or HTTP callbacks.
(module
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $args_sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_get" (func $args (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $env_sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $env (param i32 i32) (result i32)))
  (memory (export "memory") 4)
  (data (i32.const 96) "\0a")
  (func $print (param $pointer i32) (param $length i32)
    (i32.store (i32.const 0) (local.get $pointer))
    (i32.store (i32.const 4) (local.get $length))
    (if (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)) (then unreachable)))
  (func $string (param $pointer i32)
    (local $length i32)
    (block $end (loop $next
      (br_if $end (i32.eqz (i32.load8_u (i32.add (local.get $pointer) (local.get $length)))))
      (local.set $length (i32.add (local.get $length) (i32.const 1)))
      (br $next)))
    (call $print (local.get $pointer) (local.get $length))
    (call $print (i32.const 96) (i32.const 1)))
  (func (export "_start")
    (local $index i32)
    (drop (call $args_sizes (i32.const 16) (i32.const 20)))
    (if (i32.gt_u (i32.load (i32.const 16)) (i32.const 1)) (then
      (drop (call $args (i32.const 256) (i32.const 2048)))
      (block $end (loop $next
        (br_if $end (i32.ge_u (local.get $index) (i32.load (i32.const 16))))
        (call $string (i32.load (i32.add (i32.const 256) (i32.mul (local.get $index) (i32.const 4)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
      (drop (call $env_sizes (i32.const 16) (i32.const 20)))
      (drop (call $env (i32.const 256) (i32.const 2048)))
      (local.set $index (i32.const 0))
      (block $end (loop $next
        (br_if $end (i32.ge_u (local.get $index) (i32.load (i32.const 16))))
        (call $string (i32.load (i32.add (i32.const 256) (i32.mul (local.get $index) (i32.const 4)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))))
    (block $end (loop $next
      (i32.store (i32.const 0) (i32.const 131072))
      (i32.store (i32.const 4) (i32.const 65536))
      (if (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)) (then unreachable))
      (br_if $end (i32.eqz (i32.load (i32.const 8))))
      (call $print (i32.const 131072) (i32.load (i32.const 8)))
      (br $next))))
)
