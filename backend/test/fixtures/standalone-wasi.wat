(module
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $args_sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_get" (func $args (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $env_sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $env (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 100) "diagnostic\0a")
  (data (i32.const 120) "\0a")
  (func $print (param $ptr i32) (param $len i32) (param $fd i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $str (param $ptr i32)
    (local $len i32)
    (block $done (loop $loop
      (br_if $done (i32.eqz (i32.load8_u (i32.add (local.get $ptr) (local.get $len)))))
      (local.set $len (i32.add (local.get $len) (i32.const 1)))
      (br $loop)))
    (call $print (local.get $ptr) (local.get $len) (i32.const 1))
    (call $print (i32.const 120) (i32.const 1) (i32.const 1)))
  (func (export "_start")
    (local $i i32)
    (drop (call $args_sizes (i32.const 16) (i32.const 20)))
    (drop (call $args (i32.const 256) (i32.const 512)))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (i32.load (i32.const 16))))
      (call $str (i32.load (i32.add (i32.const 256) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $loop)))
    (drop (call $env_sizes (i32.const 16) (i32.const 20)))
    (drop (call $env (i32.const 256) (i32.const 512)))
    (local.set $i (i32.const 0))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (i32.load (i32.const 16))))
      (call $str (i32.load (i32.add (i32.const 256) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $loop)))
    (i32.store (i32.const 0) (i32.const 2048))
    (i32.store (i32.const 4) (i32.const 4096))
    (block $eof (loop $input
      (if (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)) (then unreachable))
      (br_if $eof (i32.eqz (i32.load (i32.const 8))))
      (call $print (i32.const 2048) (i32.load (i32.const 8)) (i32.const 1))
      (br $input)))
    (call $print (i32.const 100) (i32.const 11) (i32.const 2))
    (call $exit (i32.const 7)))
)
