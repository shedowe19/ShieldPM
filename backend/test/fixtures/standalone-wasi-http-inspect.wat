;; Independent HTTP JSON v1 command. Return the complete JSON stdin envelope
;; as base64 response bytes so the client can inspect exactly what the guest saw.
(module
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 16)
  (data (i32.const 128) "{\22version\22:1,\22action\22:\22respond\22,\22response\22:{\22status\22:200,\22body_base64\22:\22")
  (data (i32.const 256) "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
  (data (i32.const 384) "\22}}")
  (func $print (param $pointer i32) (param $size i32)
    (i32.store (i32.const 0) (local.get $pointer))
    (i32.store (i32.const 4) (local.get $size))
    (if (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)) (then unreachable)))
  (func $digit (param $index i32) (result i32)
    (i32.load8_u (i32.add (i32.const 256) (i32.and (local.get $index) (i32.const 63)))))
  (func (export "_start")
    (local $size i32) (local $index i32) (local $out i32) (local $value i32)
    (block $eof (loop $input
      (i32.store (i32.const 0) (i32.add (i32.const 65536) (local.get $size)))
      (i32.store (i32.const 4) (i32.const 65536))
      (if (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)) (then unreachable))
      (br_if $eof (i32.eqz (i32.load (i32.const 8))))
      (local.set $size (i32.add (local.get $size) (i32.load (i32.const 8))))
      (if (i32.gt_u (local.get $size) (i32.const 262144)) (then unreachable))
      (br $input)))
    (block $done (loop $encode
      (br_if $done (i32.ge_u (local.get $index) (local.get $size)))
      (local.set $value (i32.shl (i32.load8_u (i32.add (i32.const 65536) (local.get $index))) (i32.const 16)))
      (if (i32.lt_u (i32.add (local.get $index) (i32.const 1)) (local.get $size)) (then
        (local.set $value (i32.or (local.get $value) (i32.shl (i32.load8_u (i32.add (i32.const 65537) (local.get $index))) (i32.const 8))))))
      (if (i32.lt_u (i32.add (local.get $index) (i32.const 2)) (local.get $size)) (then
        (local.set $value (i32.or (local.get $value) (i32.load8_u (i32.add (i32.const 65538) (local.get $index)))))))
      (i32.store8 (i32.add (i32.const 400000) (local.get $out)) (call $digit (i32.shr_u (local.get $value) (i32.const 18))))
      (i32.store8 (i32.add (i32.const 400001) (local.get $out)) (call $digit (i32.shr_u (local.get $value) (i32.const 12))))
      (i32.store8 (i32.add (i32.const 400002) (local.get $out))
        (if (result i32) (i32.lt_u (i32.add (local.get $index) (i32.const 1)) (local.get $size))
          (then (call $digit (i32.shr_u (local.get $value) (i32.const 6)))) (else (i32.const 61))))
      (i32.store8 (i32.add (i32.const 400003) (local.get $out))
        (if (result i32) (i32.lt_u (i32.add (local.get $index) (i32.const 2)) (local.get $size))
          (then (call $digit (local.get $value))) (else (i32.const 61))))
      (local.set $index (i32.add (local.get $index) (i32.const 3)))
      (local.set $out (i32.add (local.get $out) (i32.const 4)))
      (br $encode)))
    (call $print (i32.const 128) (i32.const 72))
    (call $print (i32.const 400000) (local.get $out))
    (call $print (i32.const 384) (i32.const 3))))
