(module
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 128) "raw bytes preserved\0a")
  (func (export "_start")
    (local $total i32)
    (local $index i32)
    (local $count i32)
    (i32.store (i32.const 0) (i32.const 1024))
    (i32.store (i32.const 4) (i32.const 4096))
    (block $eof (loop $input
      (if (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)) (then unreachable))
      (local.set $count (i32.load (i32.const 8)))
      (br_if $eof (i32.eqz (local.get $count)))
      (local.set $index (i32.const 0))
      (block $checked (loop $check
        (br_if $checked (i32.ge_u (local.get $index) (local.get $count)))
        (if (i32.ne
          (i32.load8_u (i32.add (i32.const 1024) (local.get $index)))
          (i32.and (i32.add (local.get $total) (local.get $index)) (i32.const 255)))
          (then unreachable))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $check)))
      (local.set $total (i32.add (local.get $total) (local.get $count)))
      (br $input)))
    (if (i32.ne (local.get $total) (i32.const 65536)) (then unreachable))
    (i32.store (i32.const 0) (i32.const 128))
    (i32.store (i32.const 4) (i32.const 20))
    (drop (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))))
