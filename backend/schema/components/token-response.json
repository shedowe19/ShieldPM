{
	"type": "object",
	"description": "Full authentication response including user data",
	"additionalProperties": false,
	"properties": {
		"expires": {
			"description": "Access token expiry as ISO 8601 time string",
			"example": "2025-02-04T20:40:46.340Z",
			"type": "string"
		},
		"user": {
			"type": "object",
			"description": "Authenticated user summary",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"email",
				"nickname",
				"avatar",
				"roles"
			],
			"properties": {
				"id": {
					"$ref": "./user-object.json#/properties/id"
				},
				"name": {
					"$ref": "./user-object.json#/properties/name"
				},
				"email": {
					"$ref": "./user-object.json#/properties/email"
				},
				"nickname": {
					"$ref": "./user-object.json#/properties/nickname"
				},
				"avatar": {
					"$ref": "./user-object.json#/properties/avatar"
				},
				"roles": {
					"$ref": "./user-object.json#/properties/roles"
				}
			}
		},
		"csrfToken": {
			"description": "CSRF protection token for subsequent requests",
			"example": "csrf-token-value-here",
			"type": "string"
		},
		"token": {
			"type": "string",
			"description": "JWT access token"
		}
	},
	"required": [
		"expires",
		"user",
		"csrfToken"
	]
}
