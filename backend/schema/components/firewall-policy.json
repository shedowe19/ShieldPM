{
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"enabled": {
			"type": "boolean",
			"default": false
		},
		"list_ids": {
			"type": "array",
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "integer",
				"minimum": 1
			}
		},
		"allowlist": {
			"type": "array",
			"maxItems": 1000,
			"items": {
				"type": "string",
				"maxLength": 64
			}
		},
		"denylist": {
			"type": "array",
			"maxItems": 1000,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"address"
				],
				"properties": {
					"address": {
						"type": "string",
						"maxLength": 64
					},
					"reason": {
						"type": "string",
						"maxLength": 1000
					}
				}
			}
		},
		"public_message": {
			"type": "string",
			"maxLength": 2000
		},
		"support_url": {
			"type": "string",
			"maxLength": 2048
		},
		"internal_note": {
			"type": "string",
			"maxLength": 2000
		}
	}
}
