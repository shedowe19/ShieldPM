{
    "type": "object",
    "properties": {
        "id": {
            "type": "integer"
        },
        "created_on": {
            "type": "string"
        },
        "modified_on": {
            "type": "string"
        },
        "owner_user_id": {
            "type": "integer"
        },
        "name": {
            "type": "string"
        },
        "provider": {
            "type": "string",
            "enum": [
                "cloudflare",
                "duckdns",
                "custom"
            ]
        },
        "domains": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "config": {
            "type": "object",
            "description": "Input provider configuration. On responses only Cloudflare zone_id is included; tokens and custom URLs are omitted. Blank or omitted credentials preserve the saved value for the same provider."
        },
        "last_ipv4": {
            "type": [
                "string",
                "null"
            ]
        },
        "last_ipv6": {
            "type": [
                "string",
                "null"
            ]
        },
        "last_updated_on": {
            "type": [
                "string",
                "null"
            ]
        },
        "last_error": {
            "type": [
                "string",
                "null"
            ]
        },
        "enabled": {
            "type": "boolean"
        },
        "meta": {
            "type": "object"
        },
        "ip_ver": {
            "type": "string",
            "enum": [
                "v4",
                "v6",
                "dual"
            ],
            "default": "dual"
        },
        "has_credentials": {
            "type": "boolean",
            "readOnly": true,
            "description": "Whether provider credentials are saved. Public config contains only non-secret zone_id; tokens and custom URLs are write-only."
        }
    }
}
