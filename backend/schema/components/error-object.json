{
	"type": "object",
	"description": "Error object",
	"additionalProperties": false,
	"required": [
		"code",
		"message"
	],
	"properties": {
		"code": {
			"type": "integer",
			"example": 400
		},
		"message": {
			"type": "string",
			"example": "Bad Request"
		},
		"message_i18n": {
			"type": "string",
			"description": "Optional translation key"
		},
		"reason": {
			"type": "string",
			"enum": ["EBADCSRFTOKEN"],
			"description": "Present only when CSRF middleware rejected the request before route execution"
		}
	}
}
