{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "assets_only": {
      "type": "boolean"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_size_mb": {
      "type": "integer",
      "minimum": 16,
      "maximum": 10240
    },
    "inactive_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 604800
    },
    "cache_key": {
      "type": "string",
      "enum": ["uri", "uri_ignore_query"]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$",
            "maxLength": 256
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        }
      }
    }
  }
}
