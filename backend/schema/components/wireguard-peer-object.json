{
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "integer",
            "minimum": 1
        },
        "created_on": {
            "type": "string"
        },
        "modified_on": {
            "type": "string"
        },
        "owner_user_id": {
            "type": "integer",
            "minimum": 1
        },
        "is_deleted": {
            "type": "integer",
            "minimum": 0
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "description": {
            "type": ["string", "null"],
            "maxLength": 1024
        },
        "client_address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "client_public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "client_private_key": {
            "type": "string"
        },
        "preshared_key": {
            "type": "string"
        },
        "server_public_key": {
            "type": "string"
        },
        "endpoint": {
            "type": ["string", "null"],
            "maxLength": 320
        },
        "allowed_ips": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "persistent_keepalive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
        },
        "dns": {
            "type": ["string", "null"],
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "status": {
            "type": "integer",
            "minimum": 0
        },
        "last_handshake": {
            "type": ["string", "null"]
        },
        "transfer_rx": {
            "type": "integer",
            "minimum": 0
        },
        "transfer_tx": {
            "type": "integer",
            "minimum": 0
        },
        "meta": {
            "type": "object"
        }
    }
}
