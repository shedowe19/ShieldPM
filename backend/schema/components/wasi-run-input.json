{
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"args": {
			"type": "array",
			"maxItems": 32,
			"items": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000]*$" }
		},
		"env": {
			"type": "array",
			"maxItems": 32,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "value"],
				"properties": {
					"name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
					"value": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000]*$" }
				}
			}
		},
		"stdin": { "type": "string", "maxLength": 65536 },
		"timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 }
	}
}
