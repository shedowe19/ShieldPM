{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "targets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host", "port"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "backup": {
            "type": "boolean"
          },
          "max_fails": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "fail_timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        }
      }
    },
    "connect_timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "read_timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "host_header": {
      "type": "string",
      "maxLength": 253
    },
    "tls_server_name": {
      "type": "string",
      "maxLength": 253
    },
    "tls_verify": {
      "type": "boolean"
    }
  }
}
