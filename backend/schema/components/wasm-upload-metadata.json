{
	"type": "object",
	"additionalProperties": false,
	"required": [
		"name",
		"filename"
	],
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128,
			"pattern": "^[^\\u0000-\\u001f\\u007f]+$"
		},
		"filename": {
			"type": "string",
			"minLength": 6,
			"maxLength": 128,
			"pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+\\.[wW][aA][sS][mM]$"
		}
	}
}
