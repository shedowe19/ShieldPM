{
	"type": "object",
	"description": "Proxy Host object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"domain_names",
		"forward_host",
		"forward_port",
		"access_list_id",
		"firewall_policy_id",
		"certificate_id",
		"ssl_forced",
		"caching_enabled",
		"block_exploits",
		"advanced_config",
		"meta",
		"allow_websocket_upgrade",
		"http2_support",
		"forward_scheme",
		"enabled",
		"locations",
		"hsts_enabled",
		"hsts_subdomains",
		"bandwidth_limit",
		"forward_query",
		"maintenance_on_failure",
		"adv_limit_req_rate",
		"adv_limit_req_unit",
		"adv_limit_req_burst",
		"disable_buffering"
	],
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"domain_names": {
			"$ref": "../common.json#/properties/domain_names"
		},
		"forward_host": {
			"type": "string",
			"minLength": 1,
			"example": "127.0.0.1"
		},
		"forward_port": {
			"type": ["integer", "null"],
			"minimum": 1,
			"maximum": 65535,
			"example": 8080
		},
		"access_list_id": {
			"$ref": "../common.json#/properties/access_list_id"
		},
		"firewall_policy_id": {
			"type": ["integer", "null"],
			"minimum": 1
		},
		"certificate_id": {
			"$ref": "../common.json#/properties/certificate_id"
		},
		"ssl_forced": {
			"$ref": "../common.json#/properties/ssl_forced"
		},
		"caching_enabled": {
			"$ref": "../common.json#/properties/caching_enabled"
		},
		"block_exploits": {
			"$ref": "../common.json#/properties/block_exploits"
		},
		"security_crowdsec": {
			"$ref": "../common.json#/properties/security_crowdsec"
		},
		"anubis_enabled": {
			"type": "boolean",
			"example": false
		},
		"anubis_rules": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"path": { "type": "string" },
					"action": { "type": "string", "enum": ["ALLOW", "DENY", "CHALLENGE"] },
					"user_agent": { "type": "string" },
					"headers": { "type": "object" },
					"remote_addresses": {
						"type": "array",
						"items": { "type": "string" }
					},
					"challenge_difficulty": { "type": ["integer", "null"] },
					"challenge_algorithm": {
						"type": "string",
						"enum": ["fast", "slow", "metarefresh", "preact"]
					}
				},
				"required": ["action"]
			}
		},
		"advanced_config": {
			"type": "string",
			"example": ""
		},
		"bandwidth_limit": {
			"type": ["string", "null"],
			"example": ""
		},
		"forward_query": {
			"type": ["string", "null"],
			"example": "api_key=123"
		},
		"meta": {
			"type": "object",
			"example": {
				"nginx_online": true,
				"nginx_err": null
			}
		},
		"note": {
			"type": ["string", "null"],
			"maxLength": 10000,
			"example": "Do not delete this host."
		},
		"allow_websocket_upgrade": {
			"description": "Allow Websocket Upgrade for all paths",
			"type": "boolean",
			"example": true
		},
		"http2_support": {
			"$ref": "../common.json#/properties/http2_support"
		},
		"forward_scheme": {
			"type": "string",
			"enum": ["http", "https", "path", "grpc", "grpcs", "terminal"],
			"example": "http"
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"locations": {
			"type": "array",
			"minItems": 0,
			"items": {
				"type": "object",
				"required": ["forward_scheme", "forward_host", "forward_port", "path"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": ["integer", "null"]
					},
					"path": {
						"type": "string",
						"minLength": 1
					},
					"forward_scheme": {
						"$ref": "#/properties/forward_scheme"
					},
					"forward_host": {
						"$ref": "#/properties/forward_host"
					},
					"forward_port": {
						"$ref": "#/properties/forward_port"
					},
					"forward_query": {
						"type": ["string", "null"]
					},
					"advanced_config": {
						"type": "string"
					}
				}
			},
			"example": [
				{
					"path": "/app",
					"forward_scheme": "http",
					"forward_host": "example.com",
					"forward_port": 80
				}
			]
		},
		"hsts_enabled": {
			"$ref": "../common.json#/properties/hsts_enabled"
		},
		"hsts_subdomains": {
			"$ref": "../common.json#/properties/hsts_subdomains"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null",
					"example": null
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		},
		"access_list": {
			"oneOf": [
				{
					"type": "null",
					"example": null
				},
				{
					"$ref": "./access-list-object.json"
				}
			],
			"example": null
		},
		"maintenance_on_failure": {
			"type": "boolean",
			"example": false
		},
		"adv_limit_req_rate": {
			"type": ["integer", "null"],
			"minimum": 0,
			"maximum": 100000,
			"example": 10
		},
		"adv_limit_req_unit": {
			"type": ["string", "null"],
			"enum": ["s", "m"],
			"example": "s"
		},
		"adv_limit_req_burst": {
			"type": ["integer", "null"],
			"minimum": 0,
			"maximum": 100000,
			"example": 20
		},
		"disable_buffering": {
			"type": "boolean",
			"example": false
		},
		"maintenance_active": {
			"type": "boolean",
			"example": false
		},
		"maintenance_start": {
			"type": ["string", "null"],
			"example": "2026-01-01 10:00:00"
		},
		"maintenance_end": {
			"type": ["string", "null"],
			"example": "2026-01-01 12:00:00"
		},
		"maintenance_reason": {
			"type": ["string", "null"],
			"example": "System Upgrade"
		},
		"php_enabled": {
			"type": "boolean",
			"example": false
		},
		"php_version": {
			"type": ["string", "null"],
			"enum": ["82", "83", "84"],
			"example": "83"
		},
		"php_override_ini": {
			"type": ["string", "null"],
			"example": "memory_limit = 512M"
		},
		"index_file": {
			"type": ["string", "null"],
			"example": "index.html"
		},
		"git_repo_url": {
			"type": ["string", "null"],
			"description": "Git repository URL for auto-deployment",
			"example": "https://github.com/user/repo.git"
		},
		"git_branch": {
			"type": "string",
			"description": "Git branch to sync from",
			"default": "main",
			"example": "main"
		},
		"git_sync_enabled": {
			"type": "boolean",
			"description": "Enable automatic Git polling",
			"example": false
		},
		"git_poll_interval": {
			"type": "integer",
			"description": "Polling interval value",
			"minimum": 10,
			"maximum": 86400,
			"default": 60,
			"example": 60
		},
		"git_poll_unit": {
			"type": "string",
			"description": "Polling interval unit: s (seconds), m (minutes), h (hours)",
			"enum": ["s", "m", "h"],
			"default": "m",
			"example": "m"
		},
		"git_credentials": {
			"type": ["string", "null"],
			"description": "Personal Access Token for private repos (write-only)",
			"example": null
		},
		"git_last_sync": {
			"type": ["string", "null"],
			"description": "Last successful sync timestamp",
			"example": "2026-01-19 12:00:00"
		},
		"git_last_commit": {
			"type": ["string", "null"],
			"description": "Last synced commit SHA",
			"example": "abc123def456"
		},
		"git_last_error": {
			"type": ["string", "null"],
			"description": "Last sync error message",
			"example": null
		},
		"icon_url": {
			"type": ["string", "null"],
			"description": "Custom icon URL",
			"maxLength": 512,
			"example": "https://example.com/icon.svg"
		},
		"icon_type": {
			"type": "string",
			"enum": ["auto", "custom", "none"],
			"default": "auto",
			"example": "auto"
		},
		"terminal_host": {
			"type": ["string", "null"],
			"description": "Terminal SSH Host",
			"example": "192.168.1.10"
		},
		"terminal_port": {
			"type": ["integer", "null"],
			"description": "Terminal SSH Port",
			"example": 22
		},
		"terminal_username": {
			"type": ["string", "null"],
			"description": "Terminal SSH Username",
			"example": "root"
		},
		"terminal_auth_type": {
			"type": ["string", "null"],
			"enum": ["password", "key"],
			"example": "password"
		},
		"terminal_password": {
			"type": ["string", "null"],
			"description": "Encrypted Password",
			"example": "encrypted..."
		},
		"terminal_private_key": {
			"type": ["string", "null"],
			"description": "Encrypted Private Key",
			"example": "encrypted..."
		},
		"turbo_loader": {
			"type": "boolean",
			"description": "Enable Browser Turbo-Loader (Multi-Part Injection) for large file downloads",
			"example": false
		}
	}
}
