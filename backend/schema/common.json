{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "common",
	"type": "object",
	"properties": {
		"id": {
			"description": "Unique identifier",
			"readOnly": true,
			"type": "integer",
			"minimum": 1,
			"example": 11
		},
		"expand": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				}
			]
		},
		"query": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 255
				}
			]
		},
		"created_on": {
			"description": "Date and time of creation",
			"readOnly": true,
			"type": "string",
			"example": "2025-10-28T04:17:54.000Z"
		},
		"modified_on": {
			"description": "Date and time of last update",
			"readOnly": true,
			"type": "string",
			"example": "2025-10-28T04:17:54.000Z"
		},
		"user_id": {
			"description": "User ID",
			"type": "integer",
			"minimum": 1,
			"example": 2
		},
		"certificate_id": {
			"description": "Certificate ID",
			"anyOf": [
				{
					"type": "integer",
					"minimum": 0,
					"example": 5
				},
				{
					"type": "string",
					"pattern": "^new$",
					"example": "new"
				}
			],
			"example": 5
		},
		"access_list_id": {
			"description": "Access List ID",
			"type": "integer",
			"minimum": 0,
			"example": 3
		},
		"domain_names": {
			"description": "Domain Names separated by a comma",
			"type": "array",
			"minItems": 1,
			"maxItems": 99,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1
			},
			"example": [
				"example.com",
				"www.example.com"
			]
		},
		"enabled": {
			"description": "Is Enabled",
			"type": "boolean",
			"example": false
		},
		"ssl_forced": {
			"description": "Is SSL Forced",
			"type": "boolean",
			"example": true
		},
		"hsts_enabled": {
			"description": "Is HSTS Enabled",
			"type": "boolean",
			"example": true
		},
		"hsts_subdomains": {
			"description": "Is HSTS applicable to all subdomains",
			"type": "boolean",
			"example": true
		},
		"ssl_provider": {
			"type": "string",
			"pattern": "^(letsencrypt|other|internal)$",
			"example": "letsencrypt"
		},
		"http2_support": {
			"description": "HTTP2 Protocol Support",
			"type": "boolean",
			"example": true
		},
		"block_exploits": {
			"description": "Should we block common exploits",
			"type": "boolean",
			"example": false
		},
		"security_crowdsec": {
			"description": "Enable CrowdSec IPS",
			"type": "boolean",
			"default": false,
			"example": false
		},
		"caching_enabled": {
			"description": "Should we cache assets",
			"type": "boolean",
			"example": true
		},
		"zstd_enabled": {
			"description": "Enable Zstd compression for this Proxy Host",
			"type": "boolean",
			"default": false,
			"example": false
		},
		"upload_relay_enabled": {
			"description": "Enable the resumable direct upload relay for this Proxy Host",
			"type": "boolean",
			"default": false,
			"example": false
		},
		"upload_relay_path": {
			"description": "Public resumable upload path",
			"type": "string",
			"pattern": "^/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$",
			"default": "/_shieldpm-upload",
			"example": "/_shieldpm-upload"
		},
		"upload_relay_target_path": {
			"description": "Private upstream path that receives the completed raw upload",
			"type": "string",
			"pattern": "^/(?!/)[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
			"default": "/",
			"example": "/api/import"
		},
		"upload_relay_chunk_size": {
			"description": "Maximum resumable upload chunk size in bytes",
			"type": "integer",
			"minimum": 5242880,
			"maximum": 94371840,
			"default": 83886080,
			"example": 83886080
		},
		"upload_relay_max_file_size": {
			"description": "Maximum completed file size in bytes",
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991,
			"default": 10737418240,
			"example": 10737418240
		},
		"upload_relay_max_pending_bytes": {
			"description": "Maximum bytes reserved by incomplete uploads for this Proxy Host",
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991,
			"default": 21474836480,
			"example": 21474836480
		},
		"upload_relay_cleanup_hours": {
			"description": "Hours before incomplete uploads are removed",
			"type": "integer",
			"minimum": 1,
			"maximum": 720,
			"default": 24,
			"example": 24
		},
		"email": {
			"description": "Email address",
			"type": "string",
			"pattern": "@",
			"minLength": 3,
			"example": "me@example.com"
		},
		"directive": {
			"type": "string",
			"enum": [
				"allow",
				"deny"
			],
			"example": "allow"
		},
		"address": {
			"type": "string",
			"example": "192.168.0.11"
		},
		"access_items": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"username": {
						"type": "string",
						"minLength": 1
					},
					"password": {
						"type": "string"
					}
				},
				"example": {
					"username": "admin",
					"password": "pass"
				}
			},
			"example": [
				{
					"username": "admin",
					"password": "pass"
				}
			]
		},
		"access_clients": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"address": {
						"$ref": "#/properties/address"
					},
					"directive": {
						"$ref": "#/properties/directive"
					}
				},
				"example": {
					"directive": "allow",
					"address": "192.168.0.0/24"
				}
			},
			"example": [
				{
					"directive": "allow",
					"address": "192.168.0.0/24"
				}
			]
		},
		"certificate_files": {
			"description": "Certificate Files",
			"content": {
				"multipart/form-data": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"certificate": {
								"type": "string",
								"example": "-----BEGIN CERTIFICATE-----\nMIID...-----END CERTIFICATE-----",
								"format": "binary"
							},
							"certificate_key": {
								"type": "string",
								"example": "-----BEGIN CERTIFICATE-----\nMIID...-----END CERTIFICATE-----",
								"format": "binary"
							},
							"intermediate_certificate": {
								"type": "string",
								"example": "-----BEGIN CERTIFICATE-----\nMIID...-----END CERTIFICATE-----",
								"format": "binary"
							}
						},
						"minProperties": 1
					},
					"example": {
						"certificate": "-----BEGIN CERTIFICATE-----\nMIID...-----END CERTIFICATE-----",
						"certificate_key": "-----BEGIN PRIVATE\nMIID...-----END CERTIFICATE-----"
					}
				}
			}
		},
		"meta": {
			"description": "Meta Data",
			"type": "object",
			"additionalProperties": true
		}
	}
}
