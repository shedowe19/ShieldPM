{
	"operationId": "requestToken",
	"summary": "Request a new access token from credentials",
	"tags": [
		"tokens"
	],
	"requestBody": {
		"description": "Credentials Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"additionalProperties": false,
					"properties": {
						"identity": {
							"minLength": 1,
							"type": "string",
							"example": "me@example.com"
						},
						"scope": {
							"minLength": 1,
							"type": "string",
							"enum": [
								"user"
							],
							"example": "user"
						},
						"secret": {
							"minLength": 1,
							"type": "string",
							"example": "bigredhorsebanana"
						}
					},
					"required": [
						"identity",
						"secret"
					],
					"type": "object"
				},
				"example": {
					"identity": "me@example.com",
					"secret": "bigredhorsebanana"
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "Authentication successful — full access + refresh tokens issued",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"expires": "2025-02-04T20:40:46.340Z",
								"token": "eyJhbGciOiJSUzUxMiIsInR5cCI6IkpXVCJ9.ey...xaHKYr3Kk6MvkUjcC4"
							}
						}
					},
					"schema": {
						"$ref": "../../components/token-object.json"
					}
				}
			}
		},
		"202": {
			"description": "2FA required — authenticate using the pending_token with a 2FA sub-endpoint",
			"content": {
				"application/json": {
					"examples": {
						"requires2FA": {
							"value": {
								"requires_2fa": true,
								"pending_token": "eyJhbGciOiJSUzUxMiIsInR5cCI6IkpXVCJ9...",
								"methods": [
									"totp",
									"yubikey"
								],
								"csrfToken": "csrf-token-value-here"
							}
						}
					},
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"requires_2fa": {
								"type": "boolean",
								"example": true
							},
							"pending_token": {
								"description": "Short-lived JWT (5min TTL) for use with POST /tokens/2fa/* sub-endpoints",
								"type": "string"
							},
							"methods": {
								"description": "Available 2FA method types for this user",
								"type": "array",
								"items": {
									"type": "string",
									"enum": [
										"totp",
										"yubikey",
										"passkey",
										"duo"
									]
								}
							},
							"csrfToken": {
								"type": "string"
							}
						},
						"required": [
							"requires_2fa",
							"pending_token",
							"methods"
						]
					}
				}
			}
		},
		"401": {
			"description": "Invalid credentials",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../components/error-object.json"
					}
				}
			}
		}
	}
}