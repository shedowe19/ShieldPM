{
	"operationId": "refreshToken",
	"summary": "Legacy token renewal (REMOVED - use POST /tokens/refresh)",
	"deprecated": true,
	"tags": [
		"tokens"
	],
	"security": [
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"410": {
			"description": "The legacy renewal endpoint no longer issues tokens",
			"headers": {
				"Deprecation": {
					"description": "Marks the endpoint as removed",
					"schema": {
						"type": "string",
						"example": "true"
					}
				},
				"Sunset": {
					"description": "Date after which the endpoint is guaranteed to be gone",
					"schema": {
						"type": "string",
						"example": "Fri, 01 Jan 2027 00:00:00 GMT"
					}
				}
			},
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 410,
									"message": "GET /tokens has been removed. Use POST /tokens/refresh to rotate a session."
								}
							}
						}
					},
					"schema": {
						"$ref": "../../components/error.json"
					}
				}
			}
		}
	}
}
