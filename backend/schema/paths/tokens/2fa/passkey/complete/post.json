{
	"operationId": "complete2FAPasskey",
	"summary": "Complete passkey authentication and receive full auth tokens",
	"tags": [
		"tokens"
	],
	"requestBody": {
		"description": "Passkey Complete Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"additionalProperties": false,
					"properties": {
						"pending_token": {
							"description": "Short-lived 2FA pending token issued by POST /tokens when 2FA is required",
							"type": "string",
							"minLength": 16,
							"maxLength": 16384
						},
						"challenge_id": {
							"description": "The challenge_id returned by POST /tokens/2fa/passkey/begin",
							"type": "string",
							"minLength": 43,
							"maxLength": 256
						},
						"auth_response": {
							"description": "The AuthenticatorAssertionResponse from navigator.credentials.get()",
							"type": "object"
						}
					},
					"required": [
						"pending_token",
						"challenge_id",
						"auth_response"
					],
					"type": "object"
				},
				"example": {
					"pending_token": "eyJhbGciOiJSUzUxMiIsInR5cCI6IkpXVCJ9...",
					"challenge_id": "opaque-server-challenge-bearer",
					"auth_response": {
						"id": "base64-encoded-credential-id",
						"rawId": "base64-encoded-raw-credential-id",
						"response": {
							"authenticatorData": "base64...",
							"clientDataJSON": "base64...",
							"signature": "base64...",
							"userHandle": "base64..."
						},
						"type": "public-key"
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "Passkey authentication successful — full auth tokens issued",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"expires": "2025-02-04T20:40:46.340Z",
								"user": {
									"id": 1,
									"email": "me@example.com",
									"name": "John Doe",
									"role": "admin"
								},
								"csrfToken": "csrf-token-value-here"
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/token-response.json"
					}
				}
			}
		},
		"400": {
			"description": "Missing required fields",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"401": {
			"description": "Invalid auth response or expired pending token",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		}
	}
}
