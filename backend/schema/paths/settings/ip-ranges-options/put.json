{
	"operationId": "updateIPRangeOptions",
	"summary": "Set automatic IP range options",
	"tags": [
		"settings"
	],
	"security": [
		{
			"bearerAuth": [
				"admin"
			]
		}
	],
	"requestBody": {
		"description": "Application automatic IP range options",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"$ref": "../../../components/ip-ranges-options-object.json"
				},
				"example": {
					"enabled": false,
					"refresh_interval_hours": 6
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The configured automatic IP range options",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/ip-ranges-options-object.json"
					},
					"example": {
						"enabled": false,
						"refresh_interval_hours": 6
					}
				}
			}
		}
	}
}
