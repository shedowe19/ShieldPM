{
	"operationId": "getNginxOptions",
	"summary": "Get Nginx formatting options",
	"tags": [
		"settings"
	],
	"security": [
		{
			"bearerAuth": [
				"admin"
			]
		}
	],
	"responses": {
		"200": {
			"description": "The configured Nginx formatting options",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/nginx-options-object.json"
					},
					"example": {
						"beautifier_enabled": true
					}
				}
			}
		}
	}
}
