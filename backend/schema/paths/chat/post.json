{
	"operationId": "createChatIntegration",
	"summary": "Create a Chat Integration",
	"tags": [
		"chat"
	],
	"security": [
		{
			"bearerAuth": [
				"user"
			]
		}
	],
	"requestBody": {
		"description": "Chat Integration Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"provider",
						"token"
					],
					"properties": {
						"provider": {
							"type": "string",
							"enum": [
								"telegram"
							]
						},
						"token": {
							"type": "string"
						},
						"enabled": {
							"type": "boolean"
						},
						"config": {
							"type": "object"
						},
						"meta": {
							"type": "object"
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "201 response",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../components/chat-integration-object.json"
					}
				}
			}
		}
	}
}
