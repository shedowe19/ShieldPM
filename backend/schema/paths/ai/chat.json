{
    "description": "Send a message to the AI Agent",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "message"
    ],
    "properties": {
        "message": {
            "type": "string",
            "minLength": 1
        },
        "history": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "type": "object",
                        "properties": {
                            "role": {
                                "type": "string",
                                "enum": [
                                    "user",
                                    "assistant",
                                    "model"
                                ]
                            },
                            "content": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "role",
                            "content"
                        ]
                    },
                    {
                        "$ref": "../../components/error.json"
                    }
                ],
                "required": [
                    "role",
                    "content"
                ]
            }
        }
    }
}