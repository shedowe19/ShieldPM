{
    "tags": [
        "AI"
    ],
    "summary": "Chat with the AI Agent",
    "operationId": "chatWithAi",
    "requestBody": {
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "description": "Send a message to the AI Agent",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "message"
                    ],
                    "properties": {
                        "message": {
                            "type": "string",
                            "minLength": 1
                        },
                        "history": {
                            "type": "array",
                            "items": {
                                "oneOf": [
                                    {
                                        "type": "object",
                                        "properties": {
                                            "role": {
                                                "type": "string",
                                                "enum": [
                                                    "user",
                                                    "assistant",
                                                    "model"
                                                ]
                                            },
                                            "content": {
                                                "type": "string"
                                            },
                                            "toolCalls": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "additionalProperties": true
                                                }
                                            },
                                            "rawParts": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "additionalProperties": true
                                                }
                                            }
                                        },
                                        "required": [
                                            "role"
                                        ]
                                    },
                                    {
                                        "$ref": "../../components/error.json"
                                    }
                                ]
                            ]
                        }
                    }
                }
            }
        }
    }
},
"responses": {
    "200": {
        "description": "AI Response",
        "content": {
            "application/json": {
                "schema": {
                    "type": "object",
                    "properties": {
                        "content": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
}