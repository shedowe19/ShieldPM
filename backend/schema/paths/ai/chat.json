{
    "tags": [
        "AI"
    ],
    "summary": "Chat with the AI Agent",
    "operationId": "chatWithAi",
    "requestBody": {
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "description": "Send a message to the AI Agent",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "message"
                    ],
                    "properties": {
                        "message": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 16384
                        },
                        "history": {
                            "type": "array",
                            "maxItems": 20,
                            "items": {
                                "type": "object",
                                "properties": {
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "user",
                                            "assistant"
                                        ]
                                    },
                                    "content": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 16384
                                    }
                                },
                                "required": [
                                    "role",
                                    "content"
                                ],
                                "additionalProperties": false
                            }
                        }
                    }
                }
            }
        }
    },
    "responses": {
        "200": {
            "description": "AI Response",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "content": {
                                "type": "string"
                            },
                            "confirmation": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["token", "tool", "details"],
                                "properties": {
                                    "token": { "type": "string" },
                                    "tool": { "type": "string" },
                                    "details": { "type": "string" }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "security": [
        {
            "jwt": []
        }
    ]
}
