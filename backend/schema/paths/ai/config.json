{
    "tags": [
        "AI"
    ],
    "summary": "Update AI Configuration",
    "operationId": "updateAiConfig",
    "requestBody": {
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "description": "Configuration usage for the AI Agent",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "enabled",
                        "provider"
                    ],
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "provider": {
                            "type": "string",
                            "enum": [
                                "gemini",
                                "local"
                            ]
                        },
                        "api_key": {
                            "type": "string"
                        },
                        "base_url": {
                            "type": "string"
                        },
                        "model": {
                            "type": "string"
                        },
                        "system_prompt": {
                            "type": "string"
                        },
                        "num_ctx": {
                            "type": "integer",
                            "default": 8192
                        },
                        "num_batch": {
                            "type": "integer",
                            "default": 512
                        }
                    }
                }
            }
        }
    },
    "responses": {
        "200": {
            "description": "Config Updated",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object"
                    }
                }
            }
        }
    }
}