{
	"operationId": "getNotificationTargets",
	"summary": "List own channels with write-only endpoint credentials",
	"tags": [
		"incidents"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.view"
			]
		}
	],
	"responses": {
		"200": {
			"description": "Success",
			"content": {
				"application/json": {
					"schema": {
						"type": "array",
						"items": {
							"$ref": "../../../components/notification-target.json"
						},
						"maxItems": 100
					}
				}
			}
		},
		"400": {
			"description": "Invalid input or stale configuration"
		},
		"403": {
			"description": "Permission denied"
		},
		"404": {
			"description": "Object not found within caller scope"
		}
	}
}
