{
	"operationId": "updateNotificationTarget",
	"summary": "Update own channel with an optimistic version check",
	"tags": [
		"incidents"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.manage"
			]
		}
	],
	"responses": {
		"200": {
			"description": "Success",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/notification-target.json"
					}
				}
			}
		},
		"400": {
			"description": "Invalid input or stale configuration"
		},
		"403": {
			"description": "Permission denied"
		},
		"404": {
			"description": "Object not found within caller scope"
		}
	},
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"allOf": [
						{
							"$ref": "../../../../components/notification-target-input.json"
						},
						{
							"required": [
								"version"
							]
						}
					]
				}
			}
		}
	},
	"parameters": [
		{
			"in": "path",
			"name": "targetID",
			"required": true,
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 9007199254740991
			}
		}
	]
}
