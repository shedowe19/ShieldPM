{
	"operationId": "getIncidentHosts",
	"summary": "List visible hosts for incident filtering",
	"tags": [
		"incidents"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.view"
			]
		}
	],
	"responses": {
		"200": {
			"description": "Success",
			"content": {
				"application/json": {
					"schema": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"id",
								"domain_names",
								"enabled",
								"owned"
							],
							"properties": {
								"id": {
									"type": "integer",
									"minimum": 1,
									"maximum": 9007199254740991
								},
								"domain_names": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"enabled": {
									"type": "boolean"
								},
								"owned": {
									"type": "boolean"
								}
							}
						},
						"maxItems": 2000
					}
				}
			}
		},
		"400": {
			"description": "Invalid input or stale configuration"
		},
		"403": {
			"description": "Permission denied"
		},
		"404": {
			"description": "Object not found within caller scope"
		}
	}
}
