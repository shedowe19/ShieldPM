{
	"operationId": "postNginxHostWorkspaceItems",
	"summary": "Create a personal view or validated security profile",
	"tags": [
		"proxy-hosts"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.view"
			]
		}
	],
	"responses": {
		"200": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"type": "object"
					}
				}
			}
		}
	},
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"required": [
						"kind",
						"name",
						"definition"
					],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"enum": [
								"view",
								"profile"
							]
						},
						"name": {
							"type": "string",
							"minLength": 1,
							"maxLength": 80
						},
						"definition": {
							"oneOf": [
								{
									"type": "object",
									"additionalProperties": false,
									"properties": {
										"query": {
											"type": "string",
											"maxLength": 255
										},
										"tags": {
											"type": "array",
											"maxItems": 20,
											"items": {
												"type": "string",
												"maxLength": 32
											}
										},
										"enabled": {
											"type": "boolean"
										},
										"monitor": {
											"enum": [
												"up",
												"down",
												"unknown",
												"paused"
											]
										},
										"certificate_days": {
											"type": "integer",
											"minimum": 0,
											"maximum": 365
										}
									}
								},
								{
									"type": "object",
									"required": [
										"settings"
									],
									"additionalProperties": false,
									"properties": {
										"settings": {
											"type": "object",
											"minProperties": 1
										}
									}
								}
							]
						}
					}
				}
			}
		}
	}
}
