{
	"operationId": "getNginxHostWorkspaceHosts",
	"summary": "Filter authorized hosts by tags, status, monitoring and certificate expiry",
	"tags": [
		"proxy-hosts"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.view"
			]
		}
	],
	"responses": {
		"200": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"type": "object"
					}
				}
			}
		}
	},
	"parameters": [
		{
			"in": "query",
			"name": "query",
			"schema": {
				"type": "string",
				"maxLength": 255
			}
		},
		{
			"in": "query",
			"name": "tags",
			"schema": {
				"type": "string",
				"description": "Comma-separated tags; all tags must match"
			}
		},
		{
			"in": "query",
			"name": "enabled",
			"schema": {
				"type": "boolean"
			}
		},
		{
			"in": "query",
			"name": "monitor",
			"schema": {
				"enum": [
					"up",
					"down",
					"unknown",
					"paused"
				]
			}
		},
		{
			"in": "query",
			"name": "certificate_days",
			"schema": {
				"type": "integer",
				"minimum": 0,
				"maximum": 365
			}
		},
		{
			"in": "query",
			"name": "limit",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 100
			}
		},
		{
			"in": "query",
			"name": "page",
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		}
	]
}
