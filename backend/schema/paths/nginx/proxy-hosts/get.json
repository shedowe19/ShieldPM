{
	"operationId": "getProxyHosts",
	"summary": "Get all proxy hosts",
	"tags": [
		"proxy-hosts"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.view"
			]
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Expansions",
			"schema": {
				"type": "string",
				"enum": [
					"access_list",
					"owner",
					"certificate"
				]
			}
		},
		{
			"in": "query",
			"name": "query",
			"description": "Substring search across proxy-host domain names",
			"schema": {
				"$ref": "../../../common.json#/properties/query"
			}
		},
		{
			"in": "query",
			"name": "page",
			"description": "One-based page number; requesting page or limit returns items with pagination metadata",
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		},
		{
			"in": "query",
			"name": "limit",
			"description": "Maximum items per requested page (default 100)",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 100
			}
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"created_on": "2025-10-28T01:10:26.000Z",
									"modified_on": "2025-10-28T04:07:16.000Z",
									"owner_user_id": 1,
									"domain_names": [
										"example.shieldpm.eu"
									],
									"forward_host": "127.0.0.1",
									"forward_port": 8081,
									"access_list_id": 1,
									"certificate_id": 1,
									"ssl_forced": false,
									"caching_enabled": false,
									"block_exploits": false,
									"advanced_config": "",
									"meta": {
										"nginx_online": true,
										"nginx_err": null
									},
									"allow_websocket_upgrade": false,
									"http2_support": false,
									"forward_scheme": "http",
									"enabled": true,
									"locations": [],
									"hsts_enabled": false,
									"hsts_subdomains": false
								}
							]
						}
					},
					"schema": {
						"oneOf": [
							{
								"$ref": "../../../components/proxy-host-list.json"
							},
							{
								"type": "object",
								"required": [
									"items",
									"pagination"
								],
								"properties": {
									"items": {
										"$ref": "../../../components/proxy-host-list.json"
									},
									"pagination": {
										"type": "object",
										"required": [
											"limit",
											"page",
											"totalItems",
											"totalPages"
										],
										"properties": {
											"limit": {
												"type": "integer"
											},
											"page": {
												"type": "integer"
											},
											"totalItems": {
												"type": "integer"
											},
											"totalPages": {
												"type": "integer"
											}
										}
									}
								}
							}
						]
					}
				}
			}
		}
	}
}
