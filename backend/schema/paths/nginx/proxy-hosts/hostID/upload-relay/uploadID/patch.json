{
	"operationId": "appendUploadRelayChunk",
	"summary": "Append a chunk to an upload session",
	"tags": [
		"upload-relay"
	],
	"security": [
		{
			"bearerAuth": ["proxy_hosts:update"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"required": true,
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		},
		{
			"in": "path",
			"name": "uploadID",
			"required": true,
			"schema": {
				"type": "string"
			}
		},
		{
			"in": "header",
			"name": "Upload-Offset",
			"required": true,
			"schema": {
				"type": "integer",
				"minimum": 0
			}
		},
		{
			"in": "header",
			"name": "Tus-Resumable",
			"required": true,
			"schema": {
				"type": "string"
			}
		}
	],
	"requestBody": {
		"required": true,
		"content": {
			"application/offset+octet-stream": {
				"schema": {
					"type": "string",
					"format": "binary"
				}
			}
		}
	},
	"responses": {
		"204": {
			"description": "Chunk appended",
			"headers": {
				"Upload-Offset": {
					"schema": {
						"type": "integer"
					}
				},
				"Tus-Resumable": {
					"schema": {
						"type": "string"
					}
				}
			}
		},
		"409": {
			"description": "Upload offset conflict"
		},
		"412": {
			"description": "Unsupported TUS version"
		},
		"401": {
			"description": "Authentication required"
		},
		"403": {
			"description": "Permission denied"
		}
	}
}
