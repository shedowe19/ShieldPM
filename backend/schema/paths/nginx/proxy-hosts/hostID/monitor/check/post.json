{
	"operationId": "checkProxyHostNow",
	"summary": "Run the configured check now",
	"tags": ["proxy-hosts"],
	"security": [{ "bearerAuth": ["proxy_hosts.update"] }],
	"parameters": [
		{ "in": "path", "name": "hostID", "required": true, "schema": { "type": "integer", "minimum": 1 } }
	],
	"requestBody": {
		"required": false,
		"content": { "application/json": { "schema": { "type": "object", "additionalProperties": false } } }
	},
	"responses": {
		"200": {
			"description": "New check result",
			"content": { "application/json": { "schema": { "$ref": "../../../../../../components/proxy-host-monitor-status.json" } } }
		}
	}
}
