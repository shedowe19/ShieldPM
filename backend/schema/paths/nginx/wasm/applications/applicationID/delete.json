{
	"operationId": "deleteWasiApplication",
	"summary": "Remove catalog availability while retaining immutable bytes for accepted runs",
	"tags": [
		"wasi-applications"
	],
	"security": [
		{
			"bearerAuth": [
				"admin"
			]
		}
	],
	"responses": {
		"400": {
			"description": "Invalid input or unavailable runtime capacity"
		},
		"403": {
			"description": "Settings administration is required"
		},
		"404": {
			"description": "Application not found"
		},
		"200": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"required": [
							"deleted"
						],
						"properties": {
							"deleted": {
								"type": "boolean"
							}
						}
					}
				}
			}
		}
	},
	"parameters": [
		{
			"name": "applicationID",
			"in": "path",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[a-f0-9]{64}$"
			}
		}
	]
}
