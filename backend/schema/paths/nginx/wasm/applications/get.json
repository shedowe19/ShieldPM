{
	"operationId": "listWasiApplications",
	"summary": "List administrator-owned standalone WASI applications",
	"tags": [
		"wasi-applications"
	],
	"security": [
		{
			"bearerAuth": [
				"admin"
			]
		}
	],
	"responses": {
		"400": {
			"description": "Invalid input or unavailable runtime capacity"
		},
		"403": {
			"description": "Settings administration is required"
		},
		"404": {
			"description": "Application not found"
		},
		"200": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"type": "array",
						"items": {
							"$ref": "../../../../components/wasi-application.json"
						}
					}
				}
			}
		}
	}
}
