                        "allowed_ips": {
                            "$ref": "../../../components/wireguard-peer-object.json#/properties/allowed_ips"
                        },
                        "persistent_keepalive": {
                            "$ref": "../../../components/wireguard-peer-object.json#/properties/persistent_keepalive"
                        },
                        "dns": {
                            "$ref": "../../../components/wireguard-peer-object.json#/properties/dns"
                        }
                    }
                }
            }
        }
    },
    "responses": {
        "201": {
            "description": "201 response",
            "content": {
                "application/json": {
