{
    "operationId": "createWireguardPeer",
    "summary": "Create a WireGuard Peer",
    "tags": [
        "wireguard"
    ],
    "security": [
        {
            "bearerAuth": [
                "wireguard_peers.manage"
            ]
        }
    ],
    "requestBody": {
        "description": "WireGuard Peer Payload",
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "name"
                    ],
                    "properties": {
                        "name": {
                            "$ref": "../../../components/wireguard-peer-object.json#/properties/name"
                        },
                        "description": {
