{
    "operationId": "updateWireguardSettings",
    "summary": "Update WireGuard server settings",
    "tags": [
        "wireguard"
    ],
    "security": [
        {
            "bearerAuth": [
                "settings.manage"
            ]
        }
    ],
    "requestBody": {
        "description": "Partial WireGuard server settings",
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "maxLength": 253,
                            "pattern": "^(?:$|(?:[0-9A-Fa-f:]+|(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*))$"
                        },
                        "listen_port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "subnet": {
                            "type": "string",
                            "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}\\/24$"
                        },
                        "server_address": {
                            "type": "string",
                            "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}\\/24$"
                        }
                    }
                }
            }
        }
    },
    "responses": {
        "200": {
            "description": "Updated WireGuard settings"
        },
        "400": {
            "description": "Invalid WireGuard settings"
        }
    }
}
