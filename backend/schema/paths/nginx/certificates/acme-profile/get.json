{
	"operationId": "getACMEProfile",
	"summary": "Get the default Let's Encrypt certificate profile",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"bearerAuth": [
				"certificates.view"
			]
		}
	],
	"responses": {
		"200": {
			"description": "The effective profile and the source of the default",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/acme-profile-object.json"
					},
					"example": {
						"profile": "standard",
						"source": "environment"
					}
				}
			}
		}
	}
}
