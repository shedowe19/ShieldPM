{
  "tags": ["monitoring"],
  "summary": "Send a test SMTP notification",
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "requestBody": {
    "required": false,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "to": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "OK",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "sent": {
                "type": "boolean"
              },
              "message_id": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    }
  }
}
